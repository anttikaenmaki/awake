expect_status_text() {
    local expected=$1
    local actual=""
    shift

    actual=$(build_status_text "$@")
    if [[ "$actual" != "$expected" ]]; then
        printf 'Self-test failed: status text was %q instead of %q.\n' "$actual" "$expected" >&2
        exit 1
    fi
}
