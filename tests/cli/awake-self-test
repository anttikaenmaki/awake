        "none false normal" "none false unreadable" "stale false unreadable"; do
        read -r case_helper case_foreign case_pmset <<< "$found_case"
        full=$(STATUS_JSON_OUTPUT=true; print_current_status 2>/dev/null) || true
        HELPER_SESSION_FOREIGN=false
        if [[ "$case_helper" == "running" && "$case_foreign" == "true" ]]; then
            HELPER_SESSION_FOREIGN=true
        fi
        pmset_read_ok=true
        pmset_session_active=false
