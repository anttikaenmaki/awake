# The uninstaller, on a temporary home with an installation it recorded.
uninstall_home=""
uninstall_managed=""
make_uninstall_home() {
    local config_file=$1
    local created=$2

    uninstall_home=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/awake-uninstall-record.XXXXXX")
    uninstall_managed="${uninstall_home}/Library/Application Support/Awake/bin/awake"
    mkdir -p -- "$(dirname -- "$uninstall_managed")" "${uninstall_home}/.local/bin" \
        "${uninstall_home}/Applications/Awake.app/Contents" "${uninstall_home}/bin"
    printf '#!/bin/bash\nexit 0\n' > "$uninstall_managed"
    chmod 755 "$uninstall_managed"
    printf '<plist><dict><key>CFBundleIdentifier</key><string>net.kaenmaki.awake.statusbar</string></dict></plist>\n' \
        > "${uninstall_home}/Applications/Awake.app/Contents/Info.plist"
    printf '#!/bin/bash\nexec "%s" "$@"\n' "$uninstall_managed" > "${uninstall_home}/.local/bin/awake"
    chmod 755 "${uninstall_home}/.local/bin/awake"
    config_file="${uninstall_home}/${config_file}"
    {
        printf '#!/bin/bash\n'
        printf 'cli_wrapper_path=%q\n' "${uninstall_home}/.local/bin/awake"
        printf 'managed_awake_path=%q\n' "$uninstall_managed"
        printf 'app_path=%q\n' "${uninstall_home}/Applications/Awake.app"
        printf 'path_config_file=%q\n' "$config_file"
        printf 'path_line=%q\n' "$record_line"
        printf 'path_line_added=true\n'
        printf 'path_config_created=%s\n' "$created"
    } > "${uninstall_home}/Library/Application Support/Awake/install-info.sh"
}
# Runs the uninstaller; python3, which it does not need, fails.
run_uninstaller() {
    mkdir -p -- "${uninstall_home}/no-python"
    printf '#!/bin/sh\nexit 1\n' > "${uninstall_home}/no-python/python3"
    chmod 755 "${uninstall_home}/no-python/python3"
    HOME="$uninstall_home" PATH="${uninstall_home}/no-python:${PATH}" /bin/bash "${REPO_ROOT}/scripts/uninstall-awake.sh" 2>&1
}
# A startup file that the installer created goes once it is empty again.
make_uninstall_home .bash_profile true
printf '\n%s\n' "$record_line" > "${uninstall_home}/.bash_profile"
if ! output=$(run_uninstaller) || [[ -e "${uninstall_home}/.bash_profile" || -e "${uninstall_home}/.local/bin/awake" ||
    -e "${uninstall_home}/Applications/Awake.app" || -e "${uninstall_home}/Library/Application Support/Awake" ]]; then
    fail_test "Self-test failed: the uninstaller did not remove everything it installed, or the startup file it created (${output})."
fi
rm -rf -- "$uninstall_home"
# The user's own startup file keeps everything but the line.
make_uninstall_home .profile false
printf 'export MYVAR=set\n\n%s\n' "$record_line" > "${uninstall_home}/.profile"
if ! output=$(run_uninstaller) || [[ "$(cat "${uninstall_home}/.profile")" != "export MYVAR=set" ]]; then
    fail_test "Self-test failed: the uninstaller did not remove only its PATH line from ~/.profile (${output})."
fi
rm -rf -- "$uninstall_home"
# A startup file that is a symlink stays a link, even if the record says
