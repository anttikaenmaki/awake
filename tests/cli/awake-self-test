    printf '%s\n' "Self-test failed: helper process matcher accepted an empty session token." >&2
    exit 1
fi

rm -f -- /tmp/test-state
(
    umask 077
    {
        printf 'session_token=%s\n' "caffeinate-token"
        printf 'pid=%s\n' "107"
        printf 'sleep_pid=%s\n' "108"
        printf 'guard_pid=%s\n' "0"
        printf 'original_sleep=%s\n' "5"
        printf 'original_disablesleep=%s\n' "0"
        printf 'duration_seconds=%s\n' "60"
        printf 'session_mode=%s\n' "terminal"
        printf 'session_backend=%s\n' "caffeinate"
        printf 'sound_notifications=%s\n' "false"
        printf 'started_at=%s\n' "1700000000"
        printf 'deadline_at=%s\n' "1700000060"
    } > /tmp/test-state
)
