    printf '%s\n' "$output" >&2
    exit 1
fi
# Nothing can be added to a session without an end time, and no password
# is asked for.
run_helper() { printf 'RUN_HELPER %s\n' "$*" >&2; ADMIN_LAST_RESULT="ok"; }
mkdir -p -- "$HELPER_STATE_DIR"
printf 'session_token=token-none\nuid=%s\nend_mode=none\ndeadline_at=\n' "$(/usr/bin/id -u)" > "$HELPER_SESSION_FILE"
for end_args in "--duration-seconds 60" "--until @$(( $(/bin/date +%s) + 600 ))" "--indefinite"; do
    reset_main_flags
    # shellcheck disable=SC2086
    if ! output=$(main --terminal $end_args 2>&1) ||
        [[ "$output" != *"Awake already runs until you stop it."* || "$output" == *"RUN_HELPER"* ]]; then
        printf 'Self-test failed: %s changed a session without an end time.\n' "$end_args" >&2
