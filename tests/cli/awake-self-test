[[ "$(format_remaining_duration 172799)" == "2 days" ]] || fail "format_remaining_duration 172799 gave $(format_remaining_duration 172799)."
[[ "$(format_remaining_duration 90061)" == "1 day 2 hours" ]] || fail "format_remaining_duration 90061 gave $(format_remaining_duration 90061)."
MOCK_NOW=$(epoch_of "$at")
[[ "$(format_deadline_label "$(epoch_of "2026-09-28 18:30:00")")" == "18:30" ]] || fail "a deadline today was not labelled with its time."
[[ "$(format_deadline_label "$(epoch_of "2026-09-30 17:00:00")")" == "2026-09-30 17:00" ]] || fail "a deadline two days away was not labelled with its date."
MOCK_NOW=$(epoch_of "2026-09-28 23:59:30")
[[ "$(format_deadline_label "$(epoch_of "2026-09-29 00:10:00")")" == "tomorrow 00:10" ]] || fail "a deadline after midnight was not labelled tomorrow."
[[ "$(format_deadline_label "$(epoch_of "2026-09-28 23:59:50")")" == "23:59" ]] || fail "a deadline before midnight was labelled tomorrow."

# Process start times do not depend on the time zone.
if [[ "$(export TZ=Asia/Tokyo; process_start_time $$)" != "$(export TZ=America/Los_Angeles; process_start_time $$)" ]]; then
    fail "process_start_time depends on the time zone."
fi

# The stop waiter accepts the ends that guardrails and processes cause.
mkdir -p -- "$STATE_DIR"
for reason in low_battery overheated unplugged process_exited; do
    printf 'reason=%s\nsession_token=token-stop\nrestore_result=saved\n' "$reason" > "$STATUS_FILE"
    wait_for_requested_stop_completion "$STATE_FILE" 1 0 token-stop || fail "the stop waiter did not accept $reason."
done
rm -f -- "$STATUS_FILE"

# Changing the end of a Caffeine session.
state_session_is_active() { return 0; }
caffeinate_runner_pid_matches() { return 0; }
write_caffeine_state() {
    printf 'session_token=token-caffeine\nstarted_at=%s\nduration_seconds=60\ndeadline_at=%s\n%s' "$1" "$(( $1 + 60 ))" "$2" > "$STATE_FILE"
}
MOCK_NOW=$(epoch_of "$at")
write_caffeine_state "$MOCK_NOW" $'end_mode=duration\nending=1\n'
change_rc=0
change_caffeinate_session_end 60 || change_rc=$?
[[ "$change_rc" == "3" ]] || fail "adding time to a Caffeine session that is ending returned $change_rc instead of 3."
write_caffeine_state "$MOCK_NOW" $'end_mode=duration\n'
change_caffeinate_session_end 60 || fail "adding time to a Caffeine session failed."
[[ "$(read_state_value deadline_at "$STATE_FILE")" == "$(( MOCK_NOW + 120 ))" && "$(read_state_value end_mode "$STATE_FILE")" == "duration" ]] ||
    fail "adding time did not move the Caffeine deadline."
change_caffeinate_session_end "@$(( MOCK_NOW + 600 ))" || fail "a later end time for a Caffeine session failed."
[[ "$(read_state_value deadline_at "$STATE_FILE")" == "$(( MOCK_NOW + 600 ))" && "$(read_state_value end_mode "$STATE_FILE")" == "until" ]] ||
    fail "a later end time did not move the Caffeine deadline."
change_caffeinate_session_end "@$(( MOCK_NOW + 300 ))" || fail "an earlier end time for a Caffeine session failed."
[[ "$(read_state_value deadline_at "$STATE_FILE")" == "$(( MOCK_NOW + 600 ))" ]] || fail "an earlier end time moved the Caffeine deadline."
change_caffeinate_session_end none || fail "removing the end of a Caffeine session failed."
[[ -z "$(read_state_value deadline_at "$STATE_FILE")" && "$(read_state_value end_mode "$STATE_FILE")" == "none" &&
    "$(read_state_value session_token "$STATE_FILE")" == "token-caffeine" ]] || fail "removing the end did not update the Caffeine state."
# Sessions started by Awake 2.0.0 have no end mode and cannot lose their end.
write_caffeine_state "$MOCK_NOW" ""
if change_caffeinate_session_end none; then
    fail "the end of a Caffeine session from Awake 2.0.0 was removed."
fi
# A session whose runner is gone is over, even while its worker records
# the end.
write_caffeine_state "$MOCK_NOW" $'end_mode=duration\n'
caffeinate_runner_pid_matches() { return 1; }
change_rc=0
change_caffeinate_session_end 60 || change_rc=$?
[[ "$change_rc" == "3" ]] || fail "adding time to a Caffeine session whose runner is gone returned $change_rc instead of 3."
rm -f -- "$STATE_FILE"
[[ ! -e "${STATE_DIR}/deadline-lock" ]] || fail "the deadline lock was left behind."
# A lock left by a process that is gone is taken over at once.
mkdir -p -- "${STATE_DIR}/deadline-lock"
printf 'pid=%s\n' "999999" > "${STATE_DIR}/deadline-lock/pid"
acquire_deadline_lock "$STATE_FILE" || fail "a deadline lock left by a dead process was not taken over."
[[ "$(read_state_value pid "${STATE_DIR}/deadline-lock/pid")" == "$$" ]] || fail "the deadline lock does not name its holder."
release_deadline_lock "$STATE_FILE"
[[ ! -e "${STATE_DIR}/deadline-lock" ]] || fail "the deadline lock was not released."
EOF
}

# The builtins that replaced small programs (F) keep the rules of what they
# replaced: the key readers, the user ID, the runtime folder check, liveness,
# file modes, the clock read of a status, and the admin-only paths.
run_sourced_builtin_checks() {
    AWAKE_DRY_RUN=true AWAKE_SCRIPT_PATH="$AWAKE_SCRIPT" /bin/bash <<'EOF'
set -euo pipefail

source "$AWAKE_SCRIPT_PATH"
fail() {
    printf 'Self-test failed: %s\n' "$1" >&2
    exit 1
}
ensure_state_dir

# The key readers give what the awk reader before them gave, on the edge
# cases of the key=value files, and run no program: PATH leads nowhere.
awk_value() {
    /usr/bin/awk -F= -v key="$1" '$1 == key { print substr($0, index($0, "=") + 1); exit }' "$2"
}
reader_file="${STATE_DIR}/reader-check"
for content in 'k=v=\n' 'k=v==\n' 'k=a=b\n' 'k=\n' 'k= x \n' 'k=v\\\n' 'k=v' 'a=1\nk=2\nk=3\n' 'k\n' \
    ' k=1\n' 'k=1\r\n' '\nk=1\n' 'x=1\n' '' 'k=*\n' 'k=$(id)\n' 'kk=1\nk=2\n' '=x\nk=1\n' 'k=1\n\n\n'; do
    printf '%b' "$content" > "$reader_file"
    expected=$(awk_value k "$reader_file")
    actual=$(PATH=/nonexistent read_state_value k "$reader_file") ||
        fail "read_state_value failed on $(printf '%q' "$content")."
    into_value=unset
    PATH=/nonexistent read_state_value_into into_value k "$reader_file"
    if [[ "$actual" != "$expected" || "$into_value" != "$expected" ]]; then
        fail "the key readers gave $(printf '%q' "$actual") and $(printf '%q' "$into_value") for $(printf '%q' "$content"), awk $(printf '%q' "$expected")."
    fi
done
rm -f -- "$reader_file"
[[ -z "$(read_state_value k "$reader_file")" ]] || fail "read_state_value read a missing file."
read_state_value_into into_value k "$STATE_DIR"
[[ -z "$into_value" ]] || fail "read_state_value_into read a folder."
if [[ "$(/usr/bin/id -u)" != "0" ]]; then
    # Like awk, read_state_value fails on a file it cannot read;
    # read_state_value_into gives nothing.
    printf 'k=1\n' > "$reader_file"
    chmod 000 "$reader_file"
    reader_rc=0
    read_state_value k "$reader_file" >/dev/null || reader_rc=$?
    read_state_value_into into_value k "$reader_file"
    chmod 600 "$reader_file"
    rm -f -- "$reader_file"
    [[ "$reader_rc" == "2" && -z "$into_value" ]] || fail "an unreadable file gave status $reader_rc and $(printf '%q' "$into_value")."
fi

# The folder part of a path, as dirname gives it.
for parent_path in awake ./awake bin/awake bin//awake /awake /usr/local/bin/awake 'a b/c d'; do
    set_parent_dir parent_dir "$parent_path"
    [[ "$parent_dir" == "$(/usr/bin/dirname -- "$parent_path")" ]] ||
        fail "set_parent_dir gave $parent_dir for $parent_path, dirname $(/usr/bin/dirname -- "$parent_path")."
done
[[ "$CURRENT_UID" == "$(/usr/bin/id -u)" && "$AWAKE_USER_UID" == "$CURRENT_UID" ]] ||
    fail "CURRENT_UID is $CURRENT_UID, not the user's $(/usr/bin/id -u)."

# The builtin liveness check: this user's processes only, never 0 or 00
# (the process group), and another user's process (launchd, root's) reads
# as gone, which is why it is never used for the helper's processes.
lock_pid_is_running "$$" || fail "lock_pid_is_running missed this process."
for pid in 0 00 -1 abc "" 999999; do
    if lock_pid_is_running "$pid"; then
        fail "lock_pid_is_running took $pid for a running process."
    fi
done
pid1_uid=$(/bin/ps -o uid= -p 1 2>/dev/null || true)
pid1_uid=${pid1_uid//[[:space:]]/}
if [[ -n "$pid1_uid" && "$pid1_uid" != "$(/usr/bin/id -u)" ]] && lock_pid_is_running 1; then
    fail "lock_pid_is_running took process 1, another user's, for one of this user's."
fi

# The owner of the runtime folder is read once for a moment, then again.
# get_path_owner_uid runs in $( ), so it counts in a file.
owner_file=$(/usr/bin/mktemp "${TMPDIR:-/tmp}/awake-owner-reads.XXXXXX")
get_path_owner_uid() {
    printf 'x' >> "$owner_file"
    /usr/bin/stat -f %u "$1" 2>/dev/null
}
owner_reads() {
    local reads=""

    reads=$(<"$owner_file")
    printf '%s' "${#reads}"
}
RUNTIME_DIR_CHECKED=""
validate_runtime_dir_path "$STATE_DIR"
validate_runtime_file_path "$STATE_FILE" state
ensure_runtime_dir "$STATE_DIR"
ensure_runtime_dir "$STATE_DIR"
[[ "$(owner_reads)" == "1" ]] || fail "the runtime folder's owner was read $(owner_reads) times within a moment."
RUNTIME_DIR_CHECKED_AT=$((SECONDS - RUNTIME_DIR_RECHECK_SECONDS - 1))
validate_runtime_dir_path "$STATE_DIR"
[[ "$(owner_reads)" == "2" ]] || fail "an old check of the runtime folder's owner was used."
# SECONDS set back: the check counts as old.
RUNTIME_DIR_CHECKED_AT=$((SECONDS + 5))
validate_runtime_dir_path "$STATE_DIR"
[[ "$(owner_reads)" == "3" ]] || fail "a check from the future was used."
# Once old, a folder of another user is refused again.
RUNTIME_DIR_CHECKED_AT=$((SECONDS - RUNTIME_DIR_RECHECK_SECONDS - 1))
if output=$(get_path_owner_uid() { printf '%s' "$((CURRENT_UID + 1))"; }; validate_runtime_dir_path "$STATE_DIR" 2>&1); then
    fail "a runtime folder of another user was used once the check was old."
fi
[[ "$output" == *"belongs to another user"* ]] || fail "a runtime folder of another user gave: $output"
# A fresh check keeps its time: ensure_runtime_dir starts no new window
# without reading the owner.
validate_runtime_dir_path "$STATE_DIR"
RUNTIME_DIR_ENSURED=""
RUNTIME_DIR_CHECKED_AT=$((SECONDS - 1))
checked_at=$RUNTIME_DIR_CHECKED_AT
ensure_runtime_dir "$STATE_DIR"
[[ "$RUNTIME_DIR_CHECKED_AT" == "$checked_at" ]] ||
    fail "ensure_runtime_dir renewed the runtime folder's check without reading its owner."
# A symlink is refused at once, whatever was checked or made safe a moment
# ago: by both validators, and by ensure_runtime_dir's shortcut.
RUNTIME_DIR_CHECKED_AT=$((SECONDS - RUNTIME_DIR_RECHECK_SECONDS - 1))
ensure_runtime_dir "$STATE_DIR"
rm -rf -- "${STATE_DIR}.aside"
/bin/mv -- "$STATE_DIR" "${STATE_DIR}.aside"
ln -s "${STATE_DIR}.aside" "$STATE_DIR"
symlink_rc=0
output=$(validate_runtime_dir_path "$STATE_DIR" 2>&1) || symlink_rc=$?
symlink_file_rc=0
( validate_runtime_file_path "$STATE_FILE" state ) 2>/dev/null || symlink_file_rc=$?
symlink_ensure_rc=0
( ensure_runtime_dir "$STATE_DIR" ) 2>/dev/null || symlink_ensure_rc=$?
rm -f -- "$STATE_DIR"
/bin/mv -- "${STATE_DIR}.aside" "$STATE_DIR"
[[ "$symlink_rc" != "0" && "$symlink_file_rc" != "0" && "$symlink_ensure_rc" != "0" &&
    "$output" == *"symlinked runtime directory"* ]] ||
    fail "a runtime folder replaced by a symlink was used after a fresh check."
# A folder removed meanwhile is made again, with its mode.
ensure_runtime_dir "$STATE_DIR"
rm -rf -- "$STATE_DIR"
: > "$owner_file"
ensure_runtime_dir "$STATE_DIR"
[[ -d "$STATE_DIR" && ! -L "$STATE_DIR" && "$(/usr/bin/stat -f %Lp "$STATE_DIR")" == "700" ]] ||
    fail "a runtime folder removed meanwhile was not made again."
[[ "$(owner_reads)" == "1" ]] || fail "the owner of a runtime folder made again was read $(owner_reads) times, not once."
# Another user's folder is never fresh, whatever was recorded (-O). On a
# Mac /usr/bin is root's; where it shows as this user's, there is no such
# folder to try.
if [[ "$(/usr/bin/stat -f %u /usr/bin)" != "$CURRENT_UID" ]]; then
    RUNTIME_DIR_CHECKED=/usr/bin
    RUNTIME_DIR_CHECKED_AT=$SECONDS
    if runtime_dir_check_is_fresh /usr/bin; then
        fail "another user's folder passed as freshly checked."
    fi
    RUNTIME_DIR_CHECKED=""
fi
rm -f -- "$owner_file"
unset -f get_path_owner_uid
get_path_owner_uid() {
    /usr/bin/stat -f %u "$1" 2>/dev/null
}

# Files are written 600 without a chmod of their own (mktemp), also under
# a loose umask.
umask 022
now=$(/bin/date +%s)
write_state_file "$STATE_FILE" 5 0 60 gui caffeinate false token-modes "$now" "$((now + 60))" "$$" 0 0
rewrite_state_values "$STATE_FILE" sleep_pid 1
write_status_file "$STATUS_FILE" stopped 60 gui caffeinate false token-modes "" not_needed
printf 'session_mode=gui\n' | write_runtime_file_atomically "$SESSION_FILE" session
acquire_main_lock
lock_mode=$(/usr/bin/stat -f %Lp "$LOCK_PID_FILE")
release_main_lock
trap - EXIT
for mode_file in "$STATE_FILE" "$STATUS_FILE" "$SESSION_FILE"; do
    [[ "$(/usr/bin/stat -f %Lp "$mode_file")" == "600" ]] || fail "${mode_file##*/} was written with mode $(/usr/bin/stat -f %Lp "$mode_file")."
done
[[ "$lock_mode" == "600" ]] || fail "the lock's pid file was written with mode $lock_mode."
[[ -z "$(/bin/ls -A "$STATE_DIR" | /usr/bin/grep '\.tmp\.')" ]] || fail "a temporary file was left in the runtime folder."
rm -f -- "$STATE_FILE" "$STATUS_FILE" "$SESSION_FILE"
umask 077

# A status read takes the time once: the time left and the end time of a
# running session come from the same second.
clock_file="${STATE_DIR}/clock-reads"
: > "$clock_file"
current_epoch() {
    printf 'x' >> "$clock_file"
    /bin/date +%s
}
state_session_is_active() { return 0; }
now=$(/bin/date +%s)
write_state_file "$STATE_FILE" 5 0 3600 gui caffeinate false token-clock "$now" "$((now + 3600))" "$$" "$$" 0
status_json=$(STATUS_JSON_OUTPUT=true print_current_status)
clock_reads=$(<"$clock_file")
rm -f -- "$clock_file"
[[ "$clock_reads" == "x" ]] || fail "a status read took the time ${#clock_reads} times."
[[ "$status_json" == *'"active":true'* && "$status_json" == *'"session_token":"token-clock"'* ]] ||
    fail "the status of the clock check was: $status_json"
# A lid-closed session's time left takes the status read's time as well.
mkdir -p -- "$HELPER_STATE_DIR"
printf 'deadline_at=%s\n' "$((now + 3600))" > "$HELPER_SESSION_FILE"
helper_remaining=$(STATUS_NOW=$((now + 3000)); get_helper_remaining_seconds)
rm -f -- "$HELPER_SESSION_FILE"
[[ "$helper_remaining" == "600" ]] ||
    fail "get_helper_remaining_seconds did not take the status read's time ($helper_remaining)."
rm -f -- "$STATE_FILE"
unset -f state_session_is_active current_epoch

# The helper's three admin-only paths, with one stat: the same answer as
# one path_is_admin_only per path.
missing_path="${STATE_DIR}/missing"
for admin_paths in "/usr/bin /bin" "/usr/bin $STATE_DIR" "$STATE_DIR" "/usr/bin $missing_path" "/bin /usr/bin /usr/sbin"; do
    expected=true
    for admin_path in $admin_paths; do
        path_is_admin_only "$admin_path" || expected=false
    done
    actual=false
    # shellcheck disable=SC2086
    if paths_are_admin_only $admin_paths; then
        actual=true
    fi
    [[ "$actual" == "$expected" ]] || fail "paths_are_admin_only $admin_paths gave $actual, path_is_admin_only $expected."
done
if [[ "$(/usr/bin/stat -f %u /usr/bin)" == "0" ]] && ! paths_are_admin_only /usr/bin /bin; then
    fail "paths_are_admin_only refused /usr/bin and /bin."
fi
EOF
}

trap cleanup EXIT

printf '%s\n' "awake dry-run self-test"

cleanup

