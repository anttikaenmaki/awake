while (( standin_checks > 0 )) && /bin/kill -0 "$standin_pid" >/dev/null 2>&1; do
    /bin/sleep 0.25
    ((standin_checks -= 1))
done
if /bin/kill -0 "$standin_pid" >/dev/null 2>&1; then
    /bin/kill -KILL "$standin_pid" >/dev/null 2>&1 || true
    fail_test "Self-test failed: the caffeinate stand-in outlived the runner."
