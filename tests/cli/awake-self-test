wait_for_helper_session_start() { return 0; }
request_helper_session_stop() { printf '%s\n' "STOP_REQUESTED" >&2; return 0; }
# While a session runs, the helper's exit status 11 means it has no end time.
reset_main_flags
helper_session_state() { printf '%s' "running"; }
get_battery_setting() { settings_awake "$@"; }
get_helper_remaining_seconds() { printf '%s' "600"; }
run_helper() { HELPER_LAST_RC=11; ADMIN_LAST_RESULT="failed"; return 1; }
