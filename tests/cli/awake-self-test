expect_status_text "Awake is on and has 1 hour 5 minutes left (keep the lid open)." true 3900 caffeinate
expect_status_text "Awake is on and has 2 hours left." true 7200 awake
expect_status_text "Awake is on and has less than a minute left." true 59 awake
expect_status_text "Awake is on and has less than a minute left." true 0 awake
