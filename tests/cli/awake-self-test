#!/bin/bash
set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
readonly REPO_ROOT="$(cd -- "${SCRIPT_DIR}/../.." && pwd -P)"
readonly AWAKE_SCRIPT="${REPO_ROOT}/bin/awake"
readonly TEST_UID="$("/usr/bin/id" -u)"
readonly DRY_RUN_STATE_DIR="/tmp/keep-awake-lid-closed-dry-run-${TEST_UID}"
readonly DRY_RUN_STATE_FILE="${DRY_RUN_STATE_DIR}/state"
readonly DRY_RUN_STATUS_FILE="${DRY_RUN_STATE_DIR}/status"
readonly DRY_RUN_SESSION_FILE="${DRY_RUN_STATE_DIR}/session"
readonly DRY_RUN_STOP_REQUEST_FILE="${DRY_RUN_STATE_DIR}/stop-request"
readonly DRY_RUN_LOG_FILE="${DRY_RUN_STATE_DIR}/awake-debug.log"
readonly DRY_RUN_MOCK_PMSET_FILE="${DRY_RUN_STATE_DIR}/mock-pmset"
readonly DRY_RUN_CONTROL_STATE_DIR="/tmp/keep-awake-lid-closed-control-dry-run-${TEST_UID}"
readonly DRY_RUN_CONTROL_STATE_FILE="${DRY_RUN_CONTROL_STATE_DIR}/state"

RUNNING_STALE_PID=""
ALT_AWAKE_TEMP_DIR=""
ALT_AWAKE_SCRIPT=""

run_awake() {
    AWAKE_DRY_RUN=true /bin/bash "$AWAKE_SCRIPT" --dry-run "$@"
}

run_awake_json() {
    run_awake --status-json "$@"
}

ensure_alt_awake_copy() {
    if [[ -n "$ALT_AWAKE_SCRIPT" && -x "$ALT_AWAKE_SCRIPT" ]]; then
        return 0
    fi

    ALT_AWAKE_TEMP_DIR=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/awake-self-test-copy.XXXXXX")
    ALT_AWAKE_SCRIPT="${ALT_AWAKE_TEMP_DIR}/awake-alt"
    cp "$AWAKE_SCRIPT" "$ALT_AWAKE_SCRIPT"
    chmod 755 "$ALT_AWAKE_SCRIPT"
}

run_awake_alt() {
    ensure_alt_awake_copy
    AWAKE_DRY_RUN=true /bin/bash "$ALT_AWAKE_SCRIPT" --dry-run "$@"
}

run_awake_alt_json() {
    run_awake_alt --status-json "$@"
}

fail_test() {
    printf '%s\n' "$1" >&2
    exit 1
}

wait_for_status_with_script() {
    local awake_script=$1
    local expected_pattern=$2
    local max_checks=$3
    local sleep_seconds=${4:-0.25}
    local attempt=0
    local status=""

    while (( attempt < max_checks )); do
        status=$(AWAKE_DRY_RUN=true /bin/bash "$awake_script" --dry-run --status)
        if [[ "$status" == $expected_pattern ]]; then
            printf '%s' "$status"
            return 0
        fi
        /bin/sleep "$sleep_seconds"
        ((attempt += 1))
    done

    printf '%s' "$status"
    return 1
}

wait_for_status() {
    local expected_pattern=$1
    local max_checks=$2
    local sleep_seconds=${3:-0.25}
    local attempt=0
    local status=""

    while (( attempt < max_checks )); do
        status=$(run_awake --status)
        if [[ "$status" == $expected_pattern ]]; then
            printf '%s' "$status"
            return 0
        fi
        /bin/sleep "$sleep_seconds"
        ((attempt += 1))
    done

    printf '%s' "$status"
    return 1
}

json_field_equals() {
    local json_payload=$1
    local field_name=$2
    local expected_value=$3

    python3 - "$json_payload" "$field_name" "$expected_value" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
field_name = sys.argv[2]
expected = sys.argv[3]
value = payload.get(field_name)
if expected == "__NULL__":
    ok = value is None
elif expected == "__TRUE__":
    ok = value is True
elif expected == "__FALSE__":
    ok = value is False
else:
    ok = str(value) == expected
if not ok:
    raise SystemExit(f"{field_name}={value!r} did not match {expected!r}")
PY
}

cleanup_state() {
    run_awake --stop >/dev/null 2>&1 || true
    rm -f -- "$DRY_RUN_STATE_FILE" "$DRY_RUN_STATUS_FILE" "$DRY_RUN_SESSION_FILE" "$DRY_RUN_STOP_REQUEST_FILE" "$DRY_RUN_LOG_FILE" "$DRY_RUN_MOCK_PMSET_FILE" "$DRY_RUN_CONTROL_STATE_FILE"
    rmdir -- "$DRY_RUN_STATE_DIR" 2>/dev/null || true
    rmdir -- "$DRY_RUN_CONTROL_STATE_DIR" 2>/dev/null || true
}

cleanup_stale_pid() {
    if [[ -n "$RUNNING_STALE_PID" ]] && /bin/ps -p "$RUNNING_STALE_PID" >/dev/null 2>&1; then
        {
            /bin/kill -TERM "$RUNNING_STALE_PID" >/dev/null 2>&1 || true
            wait "$RUNNING_STALE_PID" || true
        } >/dev/null 2>&1
    fi
    RUNNING_STALE_PID=""
}

cleanup_alt_awake_copy() {
    if [[ -n "$ALT_AWAKE_TEMP_DIR" && -d "$ALT_AWAKE_TEMP_DIR" ]]; then
        rm -rf -- "$ALT_AWAKE_TEMP_DIR"
    fi
    ALT_AWAKE_TEMP_DIR=""
    ALT_AWAKE_SCRIPT=""
}

cleanup() {
    cleanup_stale_pid
    cleanup_state
    cleanup_alt_awake_copy
}

write_mock_pmset_state() {
    local sleep_value=$1
    local disablesleep_value=$2

    mkdir -p -- "$DRY_RUN_STATE_DIR"
    chmod 700 "$DRY_RUN_STATE_DIR"
    (
        umask 077
        {
            printf 'sleep=%s\n' "$sleep_value"
            printf 'disablesleep=%s\n' "$disablesleep_value"
        } > "$DRY_RUN_MOCK_PMSET_FILE"
    )
}

write_fake_state_file() {
    local stale_pid=$1
    local session_backend=${2:-awake}
    local now=0

    now=$(/bin/date +%s)
    mkdir -p -- "$DRY_RUN_STATE_DIR"
    chmod 700 "$DRY_RUN_STATE_DIR"
    (
        umask 077
        {
            printf 'session_token=%s\n' "stale-test-token"
            printf 'pid=%s\n' "$stale_pid"
            printf 'sleep_pid=%s\n' "$stale_pid"
            printf 'guard_pid=%s\n' "$stale_pid"
            printf 'original_sleep=%s\n' "5"
            printf 'original_disablesleep=%s\n' "0"
            printf 'duration_seconds=%s\n' "60"
            printf 'session_mode=%s\n' "terminal"
            printf 'session_backend=%s\n' "$session_backend"
            printf 'sound_notifications=%s\n' "false"
            printf 'started_at=%s\n' "$now"
            printf 'deadline_at=%s\n' "$((now + 60))"
        } > "$DRY_RUN_STATE_FILE"
    )
}

write_fake_status_file() {
    local reason=$1
    local duration_seconds=${2:-60}
    local session_mode=${3:-terminal}
    local session_backend=${4:-awake}
    local sound_notifications=${5:-false}
    local session_token=${6:-fake-session-token}
    local completed_at=${7:-$("/bin/date" +%s)}
    local restore_result=${8:-saved}

    mkdir -p -- "$DRY_RUN_STATE_DIR"
    chmod 700 "$DRY_RUN_STATE_DIR"
    (
        umask 077
        {
            printf 'reason=%s\n' "$reason"
            printf 'duration_seconds=%s\n' "$duration_seconds"
            printf 'session_mode=%s\n' "$session_mode"
            printf 'session_backend=%s\n' "$session_backend"
            printf 'sound_notifications=%s\n' "$sound_notifications"
            printf 'session_token=%s\n' "$session_token"
            printf 'completed_at=%s\n' "$completed_at"
            printf 'restore_result=%s\n' "$restore_result"
        } > "$DRY_RUN_STATUS_FILE"
    )
}

write_fake_session_file() {
    local duration_seconds=${1:-60}
    local session_mode=${2:-terminal}
    local session_backend=${3:-awake}
    local sound_notifications=${4:-false}
    local now=0

    now=$(/bin/date +%s)
    mkdir -p -- "$DRY_RUN_STATE_DIR"
    chmod 700 "$DRY_RUN_STATE_DIR"
    (
        umask 077
        {
            printf 'duration_seconds=%s\n' "$duration_seconds"
            printf 'session_mode=%s\n' "$session_mode"
            printf 'session_backend=%s\n' "$session_backend"
            printf 'sound_notifications=%s\n' "$sound_notifications"
            printf 'started_at=%s\n' "$now"
        } > "$DRY_RUN_SESSION_FILE"
    )
