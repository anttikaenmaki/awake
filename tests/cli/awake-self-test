}
# Succeeds when the debug log has the sound played after a session's end.
sound_played_at_end() {
    awk 'index($0, "announce_completion notification_suppressed reason=timeout") { ended = 1 }
        ended && index($0, "play_notification_sound dry_run_skipped") { played = 1 }
        END { exit !played }' "$DRY_RUN_LOG_FILE" 2>/dev/null
}
