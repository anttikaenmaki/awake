    printf '%s\n' "Self-test failed: the macOS password prompt lost the helper's exit status or message." >&2
    exit 1
fi
rm -f -- "${STATE_DIR}/admin-error"
reset_main_flags
EOF
}

# Checks the picker's answers, the selection for the app, the picker
# settings (in the self-test's own domain), and the add-time prompt.
run_sourced_picker_checks() {
    AWAKE_DRY_RUN=true AWAKE_SCRIPT_PATH="$AWAKE_SCRIPT" AWAKE_TEST_SETTINGS_DOMAIN="$TEST_SETTINGS_DOMAIN" /bin/bash <<'EOF'
set -euo pipefail

source "$AWAKE_SCRIPT_PATH"
fail() {
    printf 'Self-test failed: %s\n' "$1" >&2
    exit 1
}
domain=$AWAKE_TEST_SETTINGS_DOMAIN
settings() {
    /usr/bin/defaults delete "$domain" >/dev/null 2>&1 || true
    if [[ -n "${1:-}" ]]; then
        /usr/bin/defaults write "$domain" pickerDurations -string "$1"
    fi
    if [[ -n "${2:-}" ]]; then
        /usr/bin/defaults write "$domain" pickerDefault -string "$2"
    fi
}
expect_entries() {
    local actual=""

    actual=$(picker_entries | /usr/bin/tr '\n' ' ')
    [[ "$actual" == "$1 " ]] || fail "the picker entries were '$actual' instead of '$1' ($2)."
    actual=$(picker_entries | picker_default_entry)
    [[ "$actual" == "$3" ]] || fail "the default entry was '$actual' instead of '$3' ($2)."
}
builtins="600 1200 1800 2400 3000 3600 7200 10800 14400 21600 28800 indefinite"

# The settings: built-ins without them or for a bad value, and a cleaned-up
# list otherwise.
settings "" ""
expect_entries "$builtins" "no settings" 1200
settings "garbage" "indefinite"
expect_entries "$builtins" "garbage" indefinite
settings "indefinite" ""
expect_entries "$builtins" "only indefinite" 1200
settings "3600 600 600 90 0 31536060 7200 indefinite" "7200"
