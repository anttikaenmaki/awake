# A runner whose session record is gone ends, with its caffeinate stand-in.
cleanup_state
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --indefinite >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the Caffeine session for the orphaned-runner check did not start."
fi
runner_pid=$(awk -F= '$1 == "sleep_pid" { print $2; exit }' "$DRY_RUN_STATE_FILE")
rm -f -- "$DRY_RUN_STATE_FILE"
runner_checks=40
while (( runner_checks > 0 )) && /bin/kill -0 "$runner_pid" >/dev/null 2>&1; do
    /bin/sleep 0.25
    ((runner_checks -= 1))
done
if /bin/kill -0 "$runner_pid" >/dev/null 2>&1; then
    /bin/kill -KILL "$runner_pid" >/dev/null 2>&1 || true
    fail_test "Self-test failed: a Caffeine runner outlived its session record."
fi

# Adding time again and again to a Caffeine session near its end time never
# ends it early.
cleanup_state
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --until "@$(( $(/bin/date +%s) + 3 ))" >/dev/null
for add_round in 1 2 3 4 5 6; do
    if ! run_awake --terminal --duration 60s >/dev/null 2>&1; then
        fail_test "Self-test failed: adding time to a Caffeine session near its end failed (round $add_round)."
    fi
    /bin/sleep 0.5
