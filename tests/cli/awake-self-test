    exit 1
}
epoch_of() {
    /bin/date -j -f '%Y-%m-%d %H:%M:%S' "$1" +%s
}
local_time() {
    /bin/date -j -r "$1" '+%Y-%m-%d %H:%M'
}
MOCK_NOW=0
current_epoch() {
    printf '%s' "$MOCK_NOW"
}
# expect_end CONTEXT INPUT NOW RESULT, where RESULT is "until DATE TIME",
# "duration SECONDS", "none", or "reject".
expect_end() {
    local actual="reject"

    MOCK_NOW=$(epoch_of "$3")
    if parse_end_spec "$1" "$2"; then
        case "$PARSED_END_MODE" in
            until) actual="until $(local_time "$PARSED_DEADLINE")" ;;
            duration) actual="duration $PARSED_SECONDS" ;;
            none) actual="none" ;;
        esac
    fi
    if [[ "$actual" != "$4" ]]; then
        fail "parse_end_spec $1 '$2' at $3 gave '$actual' instead of '$4'."
    fi
}

