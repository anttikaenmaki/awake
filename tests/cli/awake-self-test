make_uninstall_home .profile false
mkdir -p -- "${uninstall_home}/Applications/Other.app"
printf '#!/bin/bash\necho mine\n' > "${uninstall_home}/bin/awake"
printf 'app_path=%q\ncli_wrapper_path=%q\n' "${uninstall_home}/Applications" "${uninstall_home}/bin/awake" \
