    exit 1
fi
if main_lock_pid_is_running 107; then
    printf '%s\n' "Self-test failed: main lock accepted a --caffeinate-start helper process." >&2
    exit 1
fi
if main_lock_pid_is_running 108; then
    printf '%s\n' "Self-test failed: main lock accepted a --caffeinate-runner helper process." >&2
    exit 1
fi
mkdir -p -- "$LOCK_DIR"
(
    umask 077
    {
        printf 'pid=%s\n' "109"
        printf 'script_path=%s\n' "$alt_script_path"
    } > "$LOCK_PID_FILE"
)
if ! main_lock_pid_is_running 109; then
    printf '%s\n' "Self-test failed: main lock did not honor the stored alternate script path." >&2
    exit 1
fi
rm -f -- "$LOCK_PID_FILE"
