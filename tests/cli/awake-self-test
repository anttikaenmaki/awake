# --notifications turns notifications on and --no-notifications off; of the
# two, the last one counts. After --, both belong to the command. Each case
# starts from the default in a subshell, as a parse error exits, and clears
# the --gui-custom and --status-json that earlier checks left set.
expect_notification_parse() {
    local expected=$1
    local actual=""
    shift

    if ! actual=$(
        FORCE_GUI=false
        FORCE_GUI_CUSTOM=false
        STATUS_ONLY=false
        STATUS_JSON_OUTPUT=false
        NOTIFICATIONS_SETTING=default
        SUPPRESS_NOTIFICATIONS=true
