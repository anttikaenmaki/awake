source "$AWAKE_SCRIPT_PATH"
# The real notify_gui and state_session_is_ready, kept as saved_notify_gui and
# saved_state_session_is_ready for the checks that run after stand-ins
# replace them.
eval "saved_$(declare -f notify_gui)"
eval "saved_$(declare -f state_session_is_ready)"
alt_script_path="/tmp/alt-awake-script"

process_command_line() {
    case "$1" in
        101)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --dry-run --terminal --duration-seconds 60"
            ;;
        102)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --root-start /tmp/test-state 5 0 60 terminal false"
            ;;
        103)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --failsafe-restore /tmp/test-state 1700000000 token-1"
            ;;
        104)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --notify-status /tmp/test-status"
            ;;
        105)
            printf '%s\n' "/bin/sleep 30"
            ;;
        107)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --caffeinate-start /tmp/test-state 60 terminal false"
