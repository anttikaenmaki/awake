    helper_session_is_foreign() { [[ "$case_foreign" == "true" ]]; }
    helper_session_state() { printf '%s' "$case_helper"; }
    get_battery_setting() {
        [[ "$case_pmset" != "unreadable" ]] || return 1
        case "$1:$case_pmset" in
            sleep:left) printf '0' ;;
            disablesleep:left) printf '1' ;;
            sleep:*) printf '5' ;;
            *) printf '0' ;;
        esac
