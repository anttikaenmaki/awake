# Prints the definitions of the named functions of the installer, which
# cannot be sourced because it installs when it runs: each from its
# "name() {" line to the first line that is only "}".
installer_functions() {
    local name=""
    local definition=""

    for name in "$@"; do
        definition=$(awk -v start="${name}() {" '$0 == start { printing = 1 } printing { print } printing && $0 == "}" { exit }' "${REPO_ROOT}/scripts/install-awake.sh")
        if [[ -z "$definition" ]]; then
            printf 'The installer has no function %s.\n' "$name" >&2
            return 1
        fi
        printf '%s\n' "$definition"
    done
}

# Runs a command ($2 on) in a pseudo-terminal, as if typed in Terminal, and
# prints what happened. $1 has the steps, one per line:
#   expect TEXT   wait for TEXT in the output
#   raw           wait until the terminal reads single keys (stty -icanon)
#   send HEX      type the bytes, such as 0d for Enter
#   shell CMD     run CMD with /bin/bash meanwhile, and note its exit status
# The report lists the shell results, then exit=STATUS, the output, and a
# line "end".
run_in_pty() {
    python3 - "$@" <<'PY'
import os
import pty
import select
import subprocess
import sys
import termios
import time

steps = [line for line in sys.argv[1].splitlines() if line.strip()]
pid, fd = pty.fork()
if pid == 0:
    os.execv(sys.argv[2], sys.argv[2:])
output = b""
report = []


def pump(timeout):
    global output
    ready, _, _ = select.select([fd], [], [], timeout)
    if not ready:
        return True
    try:
        data = os.read(fd, 4096)
    except OSError:
        return False
    output += data
    return bool(data)


def wait_for(condition, seconds=20):
    end = time.time() + seconds
    while time.time() < end:
        if condition():
            return True
        if not pump(0.05):
            return condition()
    return False


def reads_single_keys():
    try:
        return not termios.tcgetattr(fd)[3] & termios.ICANON
    except termios.error:
        time.sleep(1)
        return True


mark = 0
for step in steps:
    kind, _, argument = step.partition(" ")
    if kind == "expect":
        if not wait_for(lambda: argument.encode() in output[mark:]):
            report.append("missing " + argument)
            break
        mark = output.index(argument.encode(), mark) + len(argument)
    elif kind == "raw":
        # Where the terminal mode cannot be seen from this side, 5 seconds
        # are plenty for awake to set it.
        wait_for(reads_single_keys, 5)
    elif kind == "send":
        # Time for the previous key to be handled.
        wait_for(lambda: False, 0.3)
        os.write(fd, bytes.fromhex(argument))
    elif kind == "shell":
        started = time.time()
        result = subprocess.run(["/bin/bash", "-c", argument], capture_output=True, text=True)
        report.append("shell rc=%d seconds=%d" % (result.returncode, time.time() - started))
wait_for(lambda: False, 20)
waited, status = os.waitpid(pid, os.WNOHANG)
if waited == 0:
    os.kill(pid, 9)
    waited, status = os.waitpid(pid, 0)
    report.append("killed")
if os.WIFEXITED(status):
    report.append("exit=%d" % os.WEXITSTATUS(status))
else:
    report.append("signal=%d" % os.WTERMSIG(status))
report.append("output=" + output.decode("utf-8", "replace"))
# Keeps the output's own last line end: $(...) drops newlines at the end.
report.append("end")
print("\n".join(report))
PY
}

wait_for_status_with_script() {
    local awake_script=$1
    local expected_pattern=$2
    local max_checks=$3
    local sleep_seconds=${4:-0.25}
    local attempt=0
    local status=""

    while (( attempt < max_checks )); do
        status=$(AWAKE_DRY_RUN=true /bin/bash "$awake_script" --dry-run --status)
        if [[ "$status" == $expected_pattern ]]; then
            printf '%s' "$status"
            return 0
        fi
        /bin/sleep "$sleep_seconds"
        ((attempt += 1))
    done

    printf '%s' "$status"
    return 1
}

wait_for_status() {
    local expected_pattern=$1
    local max_checks=$2
    local sleep_seconds=${3:-0.25}
    local attempt=0
    local status=""

    while (( attempt < max_checks )); do
        status=$(run_awake --status)
        if [[ "$status" == $expected_pattern ]]; then
            printf '%s' "$status"
            return 0
        fi
        /bin/sleep "$sleep_seconds"
        ((attempt += 1))
    done

    printf '%s' "$status"
    return 1
}

# The value of key $2 in the JSON object $1, or null.
json_value() {
    python3 -c 'import json, sys; value = json.loads(sys.argv[1]).get(sys.argv[2]); print("null" if value is None else value)' "$1" "$2"
}

json_field_equals() {
    local json_payload=$1
    local field_name=$2
    local expected_value=$3

    python3 - "$json_payload" "$field_name" "$expected_value" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
field_name = sys.argv[2]
expected = sys.argv[3]
value = payload.get(field_name)
if expected == "__NULL__":
    ok = value is None
elif expected == "__TRUE__":
    ok = value is True
elif expected == "__FALSE__":
    ok = value is False
else:
    ok = str(value) == expected
if not ok:
    raise SystemExit(f"{field_name}={value!r} did not match {expected!r}")
PY
}

cleanup_state() {
    run_awake --stop >/dev/null 2>&1 || true
    rm -f -- "$DRY_RUN_STATE_FILE" "$DRY_RUN_STATUS_FILE" "$DRY_RUN_SESSION_FILE" "$DRY_RUN_STOP_REQUEST_FILE" "$DRY_RUN_LOG_FILE" "$DRY_RUN_MOCK_PMSET_FILE" "$DRY_RUN_MOCK_BATTERY_FILE" "$DRY_RUN_MOCK_THERMAL_FILE" "$DRY_RUN_MOCK_SLEEPNOW_FILE" "$DRY_RUN_COMMAND_FINISHED_FILE" "${DRY_RUN_STATE_DIR}/dry-run-caffeinate-flags" \
        "${DRY_RUN_STATE_DIR}/dry-run-caffeinate-args" "${DRY_RUN_STATE_DIR}/dry-run-unplug-armed" "${DRY_RUN_STATE_DIR}/start-error" "${DRY_RUN_STATE_DIR}/extend-error"
    rm -rf -- "${DRY_RUN_STATE_DIR}/deadline-lock" "${DRY_RUN_STATE_DIR}/lock-takeover"
    rm -rf -- "$DRY_RUN_HELPER_STATE_DIR"
    /usr/bin/defaults delete "$TEST_SETTINGS_DOMAIN" >/dev/null 2>&1 || true
    rmdir -- "$DRY_RUN_STATE_DIR" 2>/dev/null || true
}

cleanup_stale_pid() {
    if [[ -n "$RUNNING_STALE_PID" ]] && /bin/ps -p "$RUNNING_STALE_PID" >/dev/null 2>&1; then
        {
            /bin/kill -TERM "$RUNNING_STALE_PID" >/dev/null 2>&1 || true
            wait "$RUNNING_STALE_PID" || true
        } >/dev/null 2>&1
    fi
    RUNNING_STALE_PID=""
}

cleanup_alt_awake_copy() {
    if [[ -n "$ALT_AWAKE_TEMP_DIR" && -d "$ALT_AWAKE_TEMP_DIR" ]]; then
        rm -rf -- "$ALT_AWAKE_TEMP_DIR"
    fi
    ALT_AWAKE_TEMP_DIR=""
    ALT_AWAKE_SCRIPT=""
}

cleanup_uninstall_standins() {
    local pid=""

    for pid in $UNINSTALL_STANDIN_PIDS; do
        {
            /bin/kill -KILL "$pid" >/dev/null 2>&1 || true
            wait "$pid" || true
        } >/dev/null 2>&1
    done
    UNINSTALL_STANDIN_PIDS=""
}

cleanup_app_status_report() {
    if [[ -n "$APP_STATUS_REPORT_FILE" ]]; then
        rm -f -- "$APP_STATUS_REPORT_FILE" "${APP_STATUS_REPORT_FILE}-target" \
            "${APP_STATUS_REPORT_FILE}-stderr" "${APP_STATUS_REPORT_FILE}-stderr-without"
    fi
    APP_STATUS_REPORT_FILE=""
    if [[ -n "$APP_BEFORE_REPORT_FILE" ]]; then
        rm -f -- "$APP_BEFORE_REPORT_FILE" "${APP_BEFORE_REPORT_FILE}-target" "${APP_BEFORE_REPORT_FILE}-missing" \
            "${APP_BEFORE_REPORT_FILE}-stderr" "${APP_BEFORE_REPORT_FILE}-stderr-without"
    fi
    APP_BEFORE_REPORT_FILE=""
}

cleanup() {
    cleanup_stale_pid
    cleanup_uninstall_standins
    cleanup_state
    cleanup_alt_awake_copy
    cleanup_app_status_report
}

