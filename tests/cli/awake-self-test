run_sourced_regression_checks() {
    AWAKE_DRY_RUN=true AWAKE_SCRIPT_PATH="$AWAKE_SCRIPT" /bin/bash <<'EOF'
set -euo pipefail

source "$AWAKE_SCRIPT_PATH"
alt_script_path="/tmp/alt-awake-script"

process_command_line() {
    case "$1" in
        101)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --dry-run --terminal --duration-seconds 60"
            ;;
        102)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --root-start /tmp/test-state 5 0 60 terminal false"
            ;;
        103)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --failsafe-restore /tmp/test-state 1700000000 token-1"
            ;;
        104)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --notify-status /tmp/test-status"
            ;;
        105)
            printf '%s\n' "/bin/sleep 30"
            ;;
        107)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --caffeinate-start /tmp/test-state 60 terminal false"
            ;;
        108)
            printf '%s\n' "/bin/bash $SCRIPT_PATH --caffeinate-runner /tmp/test-state 60"
            ;;
        109)
            printf '%s\n' "/bin/bash $alt_script_path --dry-run --terminal --duration-seconds 60"
            ;;
        110)
            printf '%s\n' "/bin/bash $alt_script_path --root-start /tmp/alt-state 5 0 60 terminal false"
            ;;
        111)
            printf '%s\n' "/bin/bash $alt_script_path --failsafe-restore /tmp/alt-state 1700000000 alt-token"
            ;;
        112)
            printf '%s\n' "/bin/bash $alt_script_path --caffeinate-start /tmp/alt-state 60 terminal false"
            ;;
        113)
            printf '%s\n' "/bin/bash $alt_script_path --caffeinate-runner /tmp/alt-state 60"
            ;;
        *)
            return 1
            ;;
    esac
}

