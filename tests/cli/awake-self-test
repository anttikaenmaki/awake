# A stop sends TERM to the session's worker itself, and writes a stop
# request only when the signal cannot be sent. A stand-in worker records
# the stop when TERM comes, then removes the session's record, as the
# worker does.
if ! (
    validate_managed_runtime_path() { :; }
    log_debug() { :; }
    mkdir -p -- "$STATE_DIR"
    rm -f -- "$STATE_FILE" "$STATUS_FILE" "${STATE_DIR}/standin-ready"
    (
        trap 'printf "session_token=token-signal\nreason=stopped\nrestore_result=not_needed\n" > "$STATUS_FILE"; rm -f -- "$STATE_FILE"; exit 0' TERM
        : > "${STATE_DIR}/standin-ready"
        while :; do /bin/sleep 0.1; done
    ) &
    standin_pid=$!
    standin_checks=0
    until [[ -e "${STATE_DIR}/standin-ready" ]]; do
        if (( standin_checks >= 200 )); then
            /bin/kill -KILL "$standin_pid" 2>/dev/null || true
            printf '%s\n' "Self-test failed: the stand-in worker for the stop check did not start." >&2
            exit 1
        fi
        /bin/sleep 0.05
        ((standin_checks += 1))
    done
    printf 'session_token=token-signal\npid=%s\n' "$standin_pid" > "$STATE_FILE"
    session_pid_matches() { [[ "$1" == "$standin_pid" ]]; }
    request_writes=0
    write_stop_request_file() { ((request_writes += 1)); }
    stop_started=$(/bin/date +%s)
    if ! request_active_session_stop "$STATE_FILE" || (( request_writes != 0 )) ||
        (( $(/bin/date +%s) - stop_started > 5 )); then
        /bin/kill -KILL "$standin_pid" 2>/dev/null || true
        printf '%s\n' "Self-test failed: a stop did not signal the session's worker itself." >&2
        exit 1
    fi
    wait "$standin_pid" 2>/dev/null || true
    # When the signal fails (the worker is gone), the request file is
    # written, and the stop fails at once instead of waiting.
    printf 'session_token=token-gone\npid=999999\n' > "$STATE_FILE"
    rm -f -- "$STATUS_FILE"
    session_pid_matches() { [[ "$1" == "999999" ]]; }
    stop_started=$(/bin/date +%s)
    if request_active_session_stop "$STATE_FILE" || (( request_writes != 1 )) ||
        (( $(/bin/date +%s) - stop_started > 5 )); then
        printf '%s\n' "Self-test failed: a stop whose signal failed did not fall back to the request file, or went on waiting." >&2
        exit 1
    fi
    # A process that is not the session's worker gets neither.
    session_pid_matches() { return 1; }
    if request_active_session_stop "$STATE_FILE" || (( request_writes != 1 )); then
        printf '%s\n' "Self-test failed: a stop asked a process that is not the session's worker." >&2
        exit 1
    fi
    rm -f -- "$STATE_FILE" "$STATUS_FILE" "${STATE_DIR}/standin-ready"
); then
    exit 1
fi

