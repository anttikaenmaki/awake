printf 'session_token=token-none\nuid=%s\nend_mode=none\ndeadline_at=\nwatch_pid=%s\n' "$(/usr/bin/id -u)" "$$" > "$HELPER_SESSION_FILE"
reset_main_flags
if ! output=$(main --terminal --duration-seconds 60 2>&1) ||
    [[ "$output" != *"Awake already runs until "*"(PID $$) exits."* || "$output" == *"RUN_HELPER"* ]]; then
    printf '%s\n' "Self-test failed: time was added to a session tied to a process without a limit." >&2
    printf '%s\n' "$output" >&2
    exit 1
fi
# An end time before the current one changes nothing.
printf 'session_token=token-until\nuid=%s\nend_mode=duration\ndeadline_at=%s\n' "$(/usr/bin/id -u)" "$(( $(/bin/date +%s) + 7200 ))" > "$HELPER_SESSION_FILE"
reset_main_flags
if ! output=$(main --terminal --until "@$(( $(/bin/date +%s) + 600 ))" 2>&1) ||
    [[ "$output" != *"Awake already runs until "*"Run awake --stop first to end it sooner."* || "$output" == *"RUN_HELPER"* ]]; then
    printf '%s\n' "Self-test failed: an earlier end time changed the running session." >&2
    printf '%s\n' "$output" >&2
    exit 1
fi
# Removing the time limit of a session tied to a process leaves the process
# as its end.
printf 'session_token=token-limit\nuid=%s\nend_mode=duration\ndeadline_at=%s\nwatch_pid=%s\n' "$(/usr/bin/id -u)" "$(( $(/bin/date +%s) + 7200 ))" "$$" > "$HELPER_SESSION_FILE"
run_helper() {
    printf 'session_token=token-limit\nuid=%s\nend_mode=none\ndeadline_at=\nwatch_pid=%s\n' "$(/usr/bin/id -u)" "$$" > "$HELPER_SESSION_FILE"
    ADMIN_LAST_RESULT="ok"
    HELPER_LAST_RC=0
}
reset_main_flags
if ! output=$(main --terminal --indefinite 2>&1) || [[ "$output" != *"Awake now runs until "*"(PID $$) exits."* ]]; then
    printf '%s\n' "Self-test failed: removing the limit of a session tied to a process gave the wrong message." >&2
    printf '%s\n' "$output" >&2
    exit 1
fi
run_helper() { printf 'RUN_HELPER %s\n' "$*" >&2; ADMIN_LAST_RESULT="ok"; }
rm -f -- "$HELPER_SESSION_FILE"
get_helper_remaining_seconds() { printf '%s' "600"; }

# Installing the helper also sets up its boot-time restore, in one command
# that the shell accepts, with a valid LaunchDaemon.
install_command=$(helper_install_command)
if [[ "$install_command" != *"/Library/LaunchDaemons/net.kaenmaki.awake.boot-restore.plist"* ||
    "$install_command" != *"/bin/launchctl bootstrap system "* || "$install_command" != *"<string>boot-restore</string>"* ]] ||
    ! /bin/sh -n -c "$install_command"; then
    printf '%s\n' "Self-test failed: the helper install command does not set up the boot-time restore." >&2
    printf '%s\n' "$install_command" >&2
    exit 1
fi
boot_restore_plist_content > "${STATE_DIR}/boot-restore.plist"
if ! /usr/bin/plutil -lint "${STATE_DIR}/boot-restore.plist" >/dev/null; then
    printf '%s\n' "Self-test failed: the boot-time restore LaunchDaemon is not a valid property list." >&2
    exit 1
fi
rm -f -- "${STATE_DIR}/boot-restore.plist"
# Outside dry-run mode, a helper without its LaunchDaemon is not ready, so
# the next password prompt reinstalls both.
if (
    DRY_RUN=false
    helper_path() { helper_source_path; }
    path_is_admin_only() { return 0; }
    helper_version_of() { printf '%s' "$HELPER_PROTOCOL_VERSION"; }
    [[ ! -e "$BOOT_RESTORE_PLIST" ]] && helper_is_ready
); then
    printf '%s\n' "Self-test failed: a helper without its boot-time restore counted as ready." >&2
    exit 1
fi

# The macOS password prompt passes the helper's exit status and message on.
if ! (
    run_with_admin_prompt() { printf 'EXIT:6\nthe running session was started by an older version of Awake.'; }
    if run_as_admin gui "prompt" /usr/bin/true 2>"${STATE_DIR}/admin-error"; then
        exit 1
    fi
    [[ "$HELPER_LAST_RC" == "6" && "$ADMIN_LAST_RESULT" == "failed" &&
        "$(<"${STATE_DIR}/admin-error")" == "the running session was started by an older version of Awake." ]]
); then
    printf '%s\n' "Self-test failed: the macOS password prompt lost the helper's exit status or message." >&2
    exit 1
fi
rm -f -- "${STATE_DIR}/admin-error"
reset_main_flags
EOF
}

