        parse_cli_args "$@" >/dev/null 2>&1
        printf '%s/%s/%s' "$NOTIFICATIONS_SETTING" "$SUPPRESS_NOTIFICATIONS" "${RUN_COMMAND[*]:-}"
    ); then
        printf 'Self-test failed: parse_cli_args %s exited.\n' "$*" >&2
        exit 1
    fi
    if [[ "$actual" != "$expected" ]]; then
        printf 'Self-test failed: parse_cli_args %s gave %s instead of %s.\n' "$*" "$actual" "$expected" >&2
        exit 1
    fi
}
