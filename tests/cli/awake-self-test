}
# Waits up to 15 seconds for the command $@ to succeed.
wait_until() {
    local attempt=0

    while ! "$@"; do
        if (( attempt >= 60 )); then
            return 1
        fi
        /bin/sleep 0.25
        ((attempt += 1))
    done
}
