bound_session_started() {
    local token=""

    token=$(awk -F= '$1 == "session_token" { print $2; exit }' "$DRY_RUN_STATE_FILE" 2>/dev/null) &&
        [[ -n "$token" ]] &&
        [[ "$(awk -F= '$1 == "session_token" { print $2; exit }' "$DRY_RUN_SESSION_FILE" 2>/dev/null)" == "$token" ]]
}
if ! wait_until bound_session_started; then
    fail_test "Self-test failed: the Caffeine session tied to a command did not start."
fi
/bin/kill -KILL "$(awk -F= '$1 == "pid" { print $2; exit }' "$DRY_RUN_STATE_FILE")" >/dev/null 2>&1 || true
wait "$bound_awake_pid" || true
if (( $(/bin/date +%s) - command_started > 15 )) || [[ "$(run_awake --status)" != "Awake is off." ]] ||
    [[ "$(json_value "$(run_awake_json)" last_completion_reason)" != "process_exited" ]] ||
    [[ "$(cat "${DRY_RUN_STATE_DIR}.command-err")" == *"could not stop"* ]]; then
    fail_test "Self-test failed: a Caffeine session tied to a command whose worker was killed did not end with it ($(cat "${DRY_RUN_STATE_DIR}.command-err"))."
fi
rm -f -- "${DRY_RUN_STATE_DIR}.command-err"
# A runner that its worker has not recorded yet keeps going while the
# worker runs, but ends once the worker is gone, for example killed in
# between: --status and --stop do not see it. It records the failed start
# and removes the record. A stand-in worker, recognised by its command
# line, plays the part.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
chmod 700 "$DRY_RUN_STATE_DIR"
/bin/bash -c 'while :; do /bin/sleep 1; done' "$AWAKE_SCRIPT" --caffeinate-start "$DRY_RUN_STATE_FILE" >/dev/null 2>&1 &
standin_worker_pid=$!
(
    umask 077
    printf 'session_token=unrecorded-runner-token\npid=%s\nsleep_pid=0\nguard_pid=0\nduration_seconds=\nsession_mode=terminal\nsession_backend=caffeinate\nsound_notifications=false\nstarted_at=%s\nend_mode=none\n' \
        "$standin_worker_pid" "$(/bin/date +%s)" > "$DRY_RUN_STATE_FILE"
)
AWAKE_DRY_RUN=true /bin/bash "$AWAKE_SCRIPT" --caffeinate-runner "$DRY_RUN_STATE_FILE" none 5 on off on "" >/dev/null 2>&1 &
unrecorded_runner_pid=$!
# The runner writes its caffeinate arguments just before its loop; it then
# gets a few passes with the worker still there.
wait_until /bin/test -f "${DRY_RUN_STATE_DIR}/dry-run-caffeinate-args" || true
/bin/sleep 2
if ! /bin/kill -0 "$unrecorded_runner_pid" 2>/dev/null; then
    { /bin/kill -KILL "$standin_worker_pid" || true; wait "$standin_worker_pid" || true; } >/dev/null 2>&1
    fail_test "Self-test failed: a Caffeine runner ended while its worker was still starting the session."
fi
{ /bin/kill -KILL "$standin_worker_pid" || true; wait "$standin_worker_pid" || true; } >/dev/null 2>&1
unrecorded_runner_gone() {
    ! /bin/kill -0 "$unrecorded_runner_pid" 2>/dev/null
}
if ! wait_until unrecorded_runner_gone; then
    /bin/kill -TERM "$unrecorded_runner_pid" 2>/dev/null || true
    fail_test "Self-test failed: a Caffeine runner whose worker died before recording it kept running."
fi
wait "$unrecorded_runner_pid" 2>/dev/null || true
if [[ -f "$DRY_RUN_STATE_FILE" ]] ||
    [[ "$(awk -F= '$1 == "session_token" { print $2; exit }' "$DRY_RUN_STATUS_FILE" 2>/dev/null)" != "unrecorded-runner-token" ]] ||
    [[ "$(awk -F= '$1 == "reason" { print $2; exit }' "$DRY_RUN_STATUS_FILE" 2>/dev/null)" != "failed" ]]; then
    fail_test "Self-test failed: a Caffeine runner whose worker died before recording it left its record, or did not record the failed start."
fi
cleanup_state
# The Caffeine prompt says when leftover lid-closed settings will need the
# password before it asks how long.
if ! caffeine_banner=$(AWAKE_DRY_RUN=true AWAKE_SCRIPT_PATH="$AWAKE_SCRIPT" /bin/bash -c '
    source "$AWAKE_SCRIPT_PATH"
    read_terminal_response_line() { return 1; }
    SELECTED_SESSION_BACKEND=caffeinate
    LEFTOVER_SETTINGS_PRESENT=true
    prompt_start_terminal 2>&1 || true') ||
    [[ "$caffeine_banner" != *"restored"*"first, which needs your administrator password"* || "$caffeine_banner" == *"No password is needed"* ]]; then
    fail_test "Self-test failed: the Caffeine prompt did not mention the password for leftover settings."
fi
# A timeout that restores SleepDisabled=1 set by the user does not sleep the
# Mac: that setting keeps a closed Mac awake on purpose.
cleanup_state
write_mock_pmset_state 7 1
printf 'state=0\nlid=closed\n' > "$DRY_RUN_MOCK_THERMAL_FILE"
if ! run_helper_dry start "$TEST_UID" 2 10 on >/dev/null || ! wait_for_helper_session_end 20 ||
    [[ "$(sleepnow_count)" != "0" ]] || [[ "$(awk -F= '$1 == "disablesleep" { print $2 }' "$DRY_RUN_MOCK_PMSET_FILE")" != "1" ]]; then
    fail_test "Self-test failed: the helper slept the Mac after restoring the user's SleepDisabled=1."
fi
cleanup_state

# The record of the last Caffeine session stays until a newer session ends:
# a command that finds nothing running, or a start, no longer deletes it, so
# its notifier can still post and --status-json still reports it.
cleanup_state
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 60 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the Caffeine session for the record check did not start."
fi
caffeine_token=$(awk -F= '$1 == "session_token" { print $2; exit }' "$DRY_RUN_STATE_FILE")
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --stop >/dev/null
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --stop >/dev/null
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 60 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null ||
    [[ "$(awk -F= '$1 == "session_token" { print $2; exit }' "$DRY_RUN_STATUS_FILE")" != "$caffeine_token" ]]; then
    fail_test "Self-test failed: a stop with nothing running, or a start, deleted the record of the last Caffeine session."
fi
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --stop >/dev/null
if [[ "$(awk -F= '$1 == "session_token" { print $2; exit }' "$DRY_RUN_STATUS_FILE")" == "$caffeine_token" ]] ||
    [[ "$(json_value "$(run_awake_json)" last_completion_reason)" != "stopped" ]]; then
    fail_test "Self-test failed: the second Caffeine session did not replace the record of the first."
fi
cleanup_state

printf '%s\n' "12j. Verifying the keys at the terminal prompt, that an open prompt does not block a stop, and what a terminal shows"
# awake's key reader, run in a pseudo-terminal: it prints the answer.
key_reader=(/bin/bash -c 'source "$1"; if read_terminal_response_line answer; then printf "answer=[%s]\n" "$answer"; else printf "cancelled=%s\n" "$?"; fi' _ "$AWAKE_SCRIPT")
# Every printable key is kept (and lowercased), so "1,5h" gets its hint
# instead of turning into "15h"; a NUL byte is ignored.
report=$(run_in_pty $'raw\nsend 31\nsend 2c\nsend 35\nsend 48\nsend 00\nsend 0d' "${key_reader[@]}")
[[ "$report" == *"answer=[1,5h]"* ]] || fail_test "Self-test failed: the prompt did not read 1,5H plus a NUL byte as 1,5h (${report})."
report=$(run_in_pty $'raw\nsend 0d' "${key_reader[@]}")
[[ "$report" == *"answer=[]"* ]] || fail_test "Self-test failed: Enter did not give an empty answer (${report})."
# A character that is not ASCII, such as ä, reads as one ?, so the answer
# gets a hint instead of being read without it.
report=$(run_in_pty $'raw\nsend 31\nsend c3\nsend a4\nsend 35\nsend 0d' "${key_reader[@]}")
[[ "$report" == *"answer=[1?5]"* ]] || fail_test "Self-test failed: 1ä5 was not read as 1?5 (${report})."
# Ctrl+\ cancels; it does not answer with the default.
report=$(run_in_pty $'raw\nsend 33\nsend 1c' "${key_reader[@]}")
[[ "$report" == *"cancelled=1"* ]] || fail_test "Self-test failed: Ctrl+\\ did not cancel the prompt (${report})."
# Ctrl+C ends the line before awake exits.
report=$(run_in_pty $'raw\nsend 32\nsend 03' "${key_reader[@]}")
[[ "$report" == *"exit=130"* && "$report" == *$'output=2\r\n'* ]] ||
    fail_test "Self-test failed: Ctrl+C at the prompt did not end the line and exit with 130 (${report})."
# While the add-time prompt waits for an answer, a stop is not blocked. The
# answer then no longer applies.
cleanup_state
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 600 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the Caffeine session for the open-prompt check did not start."
fi
report=$(AWAKE_SCRIPT_PATH="$AWAKE_SCRIPT" run_in_pty \
    $'expect ]: \nraw\nshell AWAKE_DRY_RUN=true AWAKE_NO_NOTIFICATIONS=true /bin/bash "$AWAKE_SCRIPT_PATH" --dry-run --terminal --stop\nsend 310d' \
    /usr/bin/env AWAKE_DRY_RUN=true AWAKE_NO_NOTIFICATIONS=true /bin/bash "$AWAKE_SCRIPT" --dry-run --start)
if [[ "$report" != *"shell rc=0 seconds="[0-4]* || "$report" != *"exit=1"* || "$report" != *"no time was added"* ]] ||
    [[ "$(run_awake --status)" != "Awake is off." ]]; then
    fail_test "Self-test failed: an open add-time prompt blocked a stop, or its answer still applied (${report})."
fi
cleanup_state
# --gui typed in a terminal prints its replies there: a stop with nothing
# running says so, also with --notifications, and posts nothing.
report=$(run_in_pty $'expect Awake mode is not active.' /usr/bin/env AWAKE_DRY_RUN=true /bin/bash "$AWAKE_SCRIPT" --dry-run --gui --stop)
if [[ "$report" != *"exit=0"* || "$report" != *"output="*"Awake mode is not active."* ]]; then
    fail_test "Self-test failed: --gui --stop in a terminal with nothing running did not say so there (${report})."
fi
report=$(run_in_pty $'expect Awake mode is not active.' \
    /usr/bin/env AWAKE_DRY_RUN=true /bin/bash "$AWAKE_SCRIPT" --dry-run --debug --notifications --gui --stop)
if [[ "$report" != *"exit=0"* || "$report" != *"output="*"Awake mode is not active."* ]] ||
    [[ ! -s "$DRY_RUN_LOG_FILE" ]] || grep -q -F -- "notify_gui start message=Awake is off" "$DRY_RUN_LOG_FILE"; then
    fail_test "Self-test failed: --gui --stop --notifications in a terminal with nothing running posted, or did not print (${report})."
fi
cleanup_state
# A start in a terminal, without -t, starts no notifier.
report=$(run_in_pty $'expect Awake activated' /usr/bin/env AWAKE_DRY_RUN=true /bin/bash "$AWAKE_SCRIPT" --dry-run --debug --duration-seconds 2)
if [[ "$report" != *"exit=0"* || "$report" != *"output="*"Awake activated"* ]] || ! wait_for_status "Awake is off." 30 >/dev/null ||
    ! grep -q -F -- "start_gui_completion_notifier suppressed" "$DRY_RUN_LOG_FILE"; then
    fail_test "Self-test failed: a start in a terminal without --notifications started a notifier (${report})."
fi
cleanup_state

printf '%s\n' "12k. Verifying that a session ends when the Mac is unplugged"
start_unplug_test_session() {
    AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --duration-seconds 60 "$@" >/dev/null
    if ! wait_for_status "Awake is on*" 20 >/dev/null; then
        fail_test "Self-test failed: the lid-closed session for the unplug check did not start."
    fi
}
# A switch to battery power counts only once the helper has seen the adapter
# during the session; the timer's heartbeat says when it has.
wait_for_unplug_armed() {
    local checks=40

    while (( checks > 0 )); do
        if [[ "$(awk -F= '$1 == "unplug_armed" { print $2; exit }' "${DRY_RUN_HELPER_STATE_DIR}/heartbeat" 2>/dev/null)" == "1" ]]; then
            return 0
        fi
        /bin/sleep 0.25
        checks=$((checks - 1))
    done
    fail_test "Self-test failed: the helper did not see the power adapter $1."
}
# Up to 15 seconds, far more than needed. The timer checks the power source
# every second in dry-run mode and ends the session on the second check in a
# row on battery power. When the timer has died, the guard notices at its next
# poll and runs the same check every 2 seconds, so it ends the session 2 to 4
# seconds after the switch.
expect_unplugged_stop() {
    if ! wait_for_status "Awake is off.*" 60 >/dev/null; then
        fail_test "Self-test failed: the helper did not end the session $1."
    fi
    if [[ "$(helper_last_value reason)" != "unplugged" ]]; then
        fail_test "Self-test failed: the helper did not record the unplugged stop $1."
    fi
}
# Invalid values are refused, by awake and by the helper.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
if output=$(run_awake --terminal --duration-seconds 60 --unplug-guard maybe 2>&1) ||
    [[ "$output" != *"Option --unplug-guard requires 'on' or 'off'."* ]]; then
    fail_test "Self-test failed: awake accepted --unplug-guard maybe ($output)."
fi
helper_rc=0
output=$(run_helper_dry start "$TEST_UID" 60 10 on maybe 2>&1) || helper_rc=$?
if [[ "$helper_rc" != "64" || "$output" != *"the unplug guard must be on or off."* ]] ||
    [[ -f "$DRY_RUN_HELPER_SESSION_FILE" ]]; then
    fail_test "Self-test failed: the helper did not refuse the unplug guard 'maybe' with its message (exit status $helper_rc: $output)."
fi
# The helper takes the unplug guard before the process to watch.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
if ! run_helper_dry start "$TEST_UID" 60 10 on on "$$" >/dev/null ||
    [[ "$(helper_session_value unplug_guard)" != "on" || "$(helper_session_value watch_pid)" != "$$" ]]; then
    fail_test "Self-test failed: the helper did not record the unplug guard and the process to watch."
fi
stop_helper_session "with the unplug guard and a process to watch"
# Unplugged during a lid-closed session: it ends as unplugged.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_battery ac 80
start_unplug_test_session --unplug-guard on
if [[ "$(helper_session_value unplug_guard)" != "on" ]]; then
    fail_test "Self-test failed: the helper did not record --unplug-guard on."
fi
wait_for_unplug_armed "on AC power"
set_mock_battery battery 80
expect_unplugged_stop "when the Mac was unplugged"
if [[ "$(AWAKE_NO_NOTIFICATIONS=true run_awake_json)" != *'"last_completion_reason":"unplugged"'* ]]; then
    fail_test "Self-test failed: --status-json did not report the unplugged stop."
fi
# With the lid closed, the Mac is put to sleep once, and SleepDisabled that
# was on before the session is turned off.
cleanup_state
write_mock_pmset_state 5 1
set_mock_thermal 0 closed
set_mock_battery ac 80
start_unplug_test_session --unplug-guard on
wait_for_unplug_armed "with the lid closed"
set_mock_battery battery 80
expect_unplugged_stop "with the lid closed"
# The helper sleeps the Mac just after it records the end.
sleepnow_checks=20
while (( sleepnow_checks > 0 )) && [[ "$(sleepnow_count)" == "0" ]]; do
    /bin/sleep 0.1
    sleepnow_checks=$((sleepnow_checks - 1))
done
if [[ "$(sleepnow_count)" != "1" ]]; then
    fail_test "Self-test failed: an unplugged session with the lid closed did not sleep the Mac once ($(sleepnow_count))."
fi
if [[ "$(awk -F= '$1 == "disablesleep" { print $2; exit }' "$DRY_RUN_MOCK_PMSET_FILE")" != "0" ||
    "$(helper_last_value disablesleep_forced)" != "1" ]] ||
    [[ "$(run_awake --status)" != *"Awake turned off pmset disablesleep, which was on before the session, so the Mac could sleep."* ]]; then
    fail_test "Self-test failed: an unplugged end did not turn SleepDisabled off, or did not report it ($(run_awake --status))."
fi
# UPS power counts as unplugged too.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_battery ac 80
start_unplug_test_session --unplug-guard on
wait_for_unplug_armed "before the UPS check"
set_mock_battery ups 80
expect_unplugged_stop "on UPS power"
# Without the option, the switch to battery power changes nothing.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_battery ac 80
start_unplug_test_session
if [[ "$(helper_session_value unplug_guard)" != "off" ]]; then
    fail_test "Self-test failed: the helper did not record the unplug guard as off by default."
fi
# Gives the timer time to see the adapter, so a guard that is wrongly on would
# have armed before the switch. A missing heartbeat fails too.
/bin/sleep 2
if [[ "$(awk -F= '$1 == "unplug_armed" { print $2; exit }' "${DRY_RUN_HELPER_STATE_DIR}/heartbeat" 2>/dev/null)" != "0" ]]; then
    fail_test "Self-test failed: the unplug guard armed on AC power without --unplug-guard."
fi
set_mock_battery battery 80
expect_still_on "on battery power without --unplug-guard"
# A session started on battery power goes on until the Mac has been plugged
# in once.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_battery battery 80
start_unplug_test_session --unplug-guard on
/bin/sleep 3
if [[ "$(run_awake --status)" != "Awake is on"* ]]; then
    fail_test "Self-test failed: --unplug-guard ended a session started on battery power."
fi
set_mock_battery ac 80
wait_for_unplug_armed "after it was plugged in"
set_mock_battery battery 80
expect_unplugged_stop "when it was unplugged after being plugged in"
# The guard ends an unplugged session whose timer has died.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_battery ac 80
start_unplug_test_session --unplug-guard on
wait_for_unplug_armed "before the timer died"
/bin/kill -KILL "$(helper_session_value timer_pid)" >/dev/null 2>&1 || true
set_mock_battery battery 80
expect_unplugged_stop "from the guard after the timer died"
# Caffeine sessions get the same option.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_battery ac 80
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 60 --unplug-guard on >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: a Caffeine session with --unplug-guard on did not start."
fi
# The runner arms the guard once it has seen the adapter.
caffeine_armed_checks=40
while (( caffeine_armed_checks > 0 )) && [[ ! -f "${DRY_RUN_STATE_DIR}/dry-run-unplug-armed" ]]; do
    /bin/sleep 0.25
    caffeine_armed_checks=$((caffeine_armed_checks - 1))
done
if [[ ! -f "${DRY_RUN_STATE_DIR}/dry-run-unplug-armed" ]]; then
    fail_test "Self-test failed: the Caffeine runner did not see the power adapter."
fi
set_mock_battery battery 80
expect_completion_reason unplugged "in Caffeine mode when the Mac was unplugged"
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_battery ac 80
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 60 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: a Caffeine session without --unplug-guard did not start."
fi
# The runner writes its flags just before its loop; after that, give it time
# to see the adapter, so a guard that is wrongly on would have armed.
caffeine_loop_checks=40
while (( caffeine_loop_checks > 0 )) && [[ ! -f "$DRY_RUN_CAFFEINATE_FLAGS_FILE" ]]; do
    /bin/sleep 0.25
    caffeine_loop_checks=$((caffeine_loop_checks - 1))
done
if [[ ! -f "$DRY_RUN_CAFFEINATE_FLAGS_FILE" ]]; then
    fail_test "Self-test failed: the Caffeine runner without --unplug-guard did not reach its loop."
fi
/bin/sleep 2
if [[ -f "${DRY_RUN_STATE_DIR}/dry-run-unplug-armed" ]]; then
    fail_test "Self-test failed: the Caffeine runner armed the unplug guard without --unplug-guard."
fi
set_mock_battery battery 80
expect_still_on "in Caffeine mode on battery power without --unplug-guard"
# Alone during a session, the option is refused like the other settings.
cleanup_state
start_unplug_test_session
if output=$(run_awake --terminal --unplug-guard on 2>&1) ||
    [[ "$output" != *"--unplug-guard, and --keep-display apply to new sessions only"* ]] ||
    [[ "$(run_awake --status)" != "Awake is on"* ]]; then
    fail_test "Self-test failed: --unplug-guard on during a session was not refused, or stopped it ($output)."
fi
run_awake --terminal --stop >/dev/null
if ! wait_for_status "Awake is off." 20 >/dev/null; then
    fail_test "Self-test failed: the session for the --unplug-guard refusal did not stop."
fi
cleanup_state

printf '%s\n' "12l. Verifying that the app's thermal state is used only by the start checks"
# Read once and removed from the environment, whatever its value; only the
# digits 0 to 3 are kept. Each value gets a fresh shell, as bin/awake sets
# readonly variables.
for thermal_value in 0 1 2 3 "" 4 -1 03 " 3" "3 " 1.0 critical $'3\n' 0x1; do
    expected=""
    case "$thermal_value" in
        0|1|2|3) expected=$thermal_value ;;
    esac
    actual=$(AWAKE_APP_THERMAL_STATE=$thermal_value AWAKE_DRY_RUN=true /bin/bash -c \
        'source "$1"; printf "%s|%s|%s" "$APP_THERMAL_STATE" "${AWAKE_APP_THERMAL_STATE-unset}" "$(/usr/bin/env | grep -c AWAKE_APP_THERMAL_STATE)"' \
        _ "$AWAKE_SCRIPT" 2>&1) || true
    if [[ "$actual" != "${expected}|unset|0" ]]; then
        fail_test "Self-test failed: AWAKE_APP_THERMAL_STATE=[${thermal_value}] gave [${actual}] instead of [${expected}|unset|0]."
    fi
done
# Up to 30 seconds after awake started, the app's value replaces osascript;
# later, with the shell's clock set back, or without a value, osascript
# runs. The Caffeine runner's check never uses it.
if ! AWAKE_APP_THERMAL_STATE=2 AWAKE_DRY_RUN=true AWAKE_SCRIPT_PATH="$AWAKE_SCRIPT" /bin/bash <<'EOF'
set -euo pipefail
source "$AWAKE_SCRIPT_PATH"
fail() {
    printf 'Self-test failed: %s\n' "$1" >&2
    exit 1
}
DRY_RUN=false
# osascript's stand-in: each run adds a line to descriptor 3 and prints
# FAKE_THERMAL_STATE.
run_with_timeout() {
    printf 'osascript\n' >&3
    printf '%s' "${FAKE_THERMAL_STATE:-0}"
}
lid_is_closed() { return 1; }
calls_file=$(/usr/bin/mktemp "${TMPDIR:-/tmp}/awake-thermal-calls.XXXXXX")
trap 'rm -f -- "$calls_file"' EXIT
# Runs a call in a subshell, as its callers do: what it prints goes to
# $result ("failed" when it fails), and how often osascript ran to
# $osascript_calls.
counted() {
    : > "$calls_file"
    result=$("$@" 3>>"$calls_file") || result="failed"
    osascript_calls=$(/usr/bin/wc -l < "$calls_file" | /usr/bin/tr -d ' ')
}
counted foreground_thermal_state
[[ "$result" == "2" && "$osascript_calls" == "0" ]] || fail "the app's fresh thermal state was not used, or osascript ran ($result, $osascript_calls)."
APP_THERMAL_STATE_SECONDS=$((SECONDS - 29))
counted foreground_thermal_state
[[ "$result" == "2" && "$osascript_calls" == "0" ]] || fail "the app's thermal state was not used at 29 seconds ($result, $osascript_calls)."
# At exactly 30 seconds. SECONDS counts whole seconds, so one can tick
# between setting the age and the function's own read, which then sees 31:
# such a try is repeated, up to 5 times. The other ages need no retry, as a
# tick only moves them further out of range or keeps them in it.
for attempt in 1 2 3 4 5; do
    seconds_before=$SECONDS
    APP_THERMAL_STATE_SECONDS=$((seconds_before - 30))
    counted foreground_thermal_state
    if (( SECONDS == seconds_before )); then
        break
    fi
done
[[ "$result" == "2" && "$osascript_calls" == "0" ]] || fail "the app's thermal state was not used at 30 seconds ($result, $osascript_calls, try $attempt)."
APP_THERMAL_STATE_SECONDS=$((SECONDS - 31))
counted foreground_thermal_state
[[ "$result" == "0" && "$osascript_calls" == "1" ]] || fail "the app's thermal state was used at 31 seconds ($result, $osascript_calls)."
APP_THERMAL_STATE_SECONDS=$((SECONDS + 5))
counted foreground_thermal_state
[[ "$result" == "0" && "$osascript_calls" == "1" ]] || fail "the app's thermal state was used after SECONDS went back ($result, $osascript_calls)."
APP_THERMAL_STATE=""
APP_THERMAL_STATE_SECONDS=$SECONDS
counted foreground_thermal_state
[[ "$result" == "0" && "$osascript_calls" == "1" ]] || fail "without the app's thermal state, osascript did not run ($result, $osascript_calls)."
# Even set in the runner's own process, it changes nothing there.
APP_THERMAL_STATE=0
FAKE_THERMAL_STATE=3
counted mac_is_overheating
[[ "$result" != "failed" && "$osascript_calls" == "1" ]] || fail "the runner's thermal check used the app's thermal state ($result, $osascript_calls)."
EOF
then
    fail_test "Self-test failed: the app's thermal state was not used as expected."
fi
# End to end: the app's value counts for the start checks (in the dry run
# it beats the mock), an invalid one is ignored, and --thermal-guard off
# still wins.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_thermal 0 open
if output=$(AWAKE_APP_THERMAL_STATE=3 run_awake --gui --start --backend caffeinate --duration-seconds 60 2>&1) ||
    [[ "$output" != *"too hot for a lid-open session"* ]]; then
    fail_test "Self-test failed: a Caffeine start ignored the app's critical thermal state ($output)."
fi
if output=$(AWAKE_APP_THERMAL_STATE=3 run_awake --gui --start --duration-seconds 60 2>&1) ||
    [[ "$output" != *"too hot for a lid-closed session"* ]]; then
    fail_test "Self-test failed: a lid-closed start ignored the app's critical thermal state ($output)."
fi
if [[ "$(run_awake --status)" != "Awake is off." ]]; then
    fail_test "Self-test failed: a start refused for the app's thermal state changed something."
fi
set_mock_thermal 3 open
if output=$(AWAKE_APP_THERMAL_STATE=7 run_awake --gui --start --backend caffeinate --duration-seconds 60 2>&1) ||
    [[ "$output" != *"too hot for a lid-open session"* ]]; then
    fail_test "Self-test failed: an invalid thermal state from the app replaced the Mac's ($output)."
fi
AWAKE_APP_THERMAL_STATE=3 AWAKE_NO_NOTIFICATIONS=true run_awake --gui --start --backend caffeinate --duration-seconds 60 --thermal-guard off >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: --thermal-guard off did not start despite the app's critical thermal state."
fi
cleanup_state
# Adding time to a lid-closed session uses it too, before any password.
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_thermal 0 open
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --duration-seconds 120 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the lid-closed session for the app's thermal state did not start."
fi
deadline_before=$(awk -F= '$1 == "deadline_at" { print $2; exit }' "$DRY_RUN_HELPER_SESSION_FILE")
if output=$(AWAKE_APP_THERMAL_STATE=3 run_awake --gui --start --duration-seconds 60 2>&1) ||
    [[ "$output" != *"too hot to keep it awake longer"* ]] ||
    [[ "$(awk -F= '$1 == "deadline_at" { print $2; exit }' "$DRY_RUN_HELPER_SESSION_FILE")" != "$deadline_before" ]]; then
    fail_test "Self-test failed: adding time ignored the app's critical thermal state ($output)."
fi
cleanup_state
# No process a start leaves running gets it: copies of awake and of the
# helper record each process's value as it starts, before awake removes it.
ensure_alt_awake_copy
thermal_probe_dir="${ALT_AWAKE_TEMP_DIR}/thermal-probe"
thermal_record="${thermal_probe_dir}/record"
mkdir -p -- "$thermal_probe_dir"
for probe_script in awake awake-helper; do
    awk -v record="$thermal_record" '
        !done && $0 == "set -euo pipefail" {
            print
            print "printf \"%s %s %s\\n\" \"${1:-}\" \"${2:-}\" \"${AWAKE_APP_THERMAL_STATE-unset}\" >> \"" record "\""
            done = 1
            next
        }
        { print }' "${REPO_ROOT}/bin/${probe_script}" > "${thermal_probe_dir}/${probe_script}"
    chmod 755 "${thermal_probe_dir}/${probe_script}"
done
# The command after -- records its own value, then gives the session's
# processes time to start.
probe_command='printf "command - %s\n" "${AWAKE_APP_THERMAL_STATE-unset}" >> "$0"; /bin/sleep 2'
expect_thermal_record() {
    local role=""

    if ! grep -qx -- "--dry-run --gui 1" "$thermal_record"; then
        cat -- "$thermal_record" >&2
        fail_test "Self-test failed: the thermal probe did not see the value in the awake the app ran ($1)."
    fi
    shift
    for role in "$@"; do
        if ! grep -q -- "^${role} " "$thermal_record" || grep -- "^${role} " "$thermal_record" | grep -qv ' unset$'; then
            cat -- "$thermal_record" >&2
            fail_test "Self-test failed: '${role}' did not run, or got the app's thermal state."
        fi
    done
}
mkdir -p -- "$DRY_RUN_STATE_DIR"
set_mock_thermal 0 open
: > "$thermal_record"
AWAKE_APP_THERMAL_STATE=1 AWAKE_NOTIFICATIONS=true AWAKE_DRY_RUN=true /bin/bash "${thermal_probe_dir}/awake" --dry-run --gui \
    --backend caffeinate -- /bin/sh -c "$probe_command" "$thermal_record" >/dev/null 2>&1
wait_for_status "Awake is off." 20 >/dev/null || true
expect_thermal_record "lid-open" --caffeinate-start --caffeinate-runner --notify-wait command
: > "$thermal_record"
AWAKE_APP_THERMAL_STATE=1 AWAKE_DRY_RUN=true /bin/bash "${thermal_probe_dir}/awake" --dry-run --gui \
    -- /bin/sh -c "$probe_command" "$thermal_record" >/dev/null 2>&1
wait_for_status "Awake is off." 20 >/dev/null || true
expect_thermal_record "lid-closed" "--dry-run start" "--dry-run run-timer" "--dry-run run-guard" command
rm -rf -- "$thermal_probe_dir"
cleanup_state

printf '%s\n' "12m. Verifying the helper runs of password-free mode, lid-closed sessions that end as they start, and the reads of the sleep settings"
# In password-free mode run_helper runs the helper through sudo at once, and
# asks sudo whether it runs the helper only after a failure. A lid-closed
# session that ends before awake sees it running is reported at once, with
# its reason. main reads the sleep settings only while no session runs, and
# once more when a session ends just as time is added, before the start
# that follows. Stand-ins log each sudo run and password dialog, each read,
# each helper run, and each start, stop, or change of a session in the
# order they happen.
if ! AWAKE_DRY_RUN=true AWAKE_SCRIPT_PATH="$AWAKE_SCRIPT" /bin/bash <<'EOF'
set -euo pipefail
source "$AWAKE_SCRIPT_PATH"
fail() {
    printf 'Self-test failed: %s\n' "$1" >&2
    exit 1
}
work_dir=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/awake-self-test-12m.XXXXXX")
trap 'rm -rf -- "$work_dir"; rm -f -- "$STATE_FILE" "$HELPER_SESSION_FILE"' EXIT
event_log="${work_dir}/events"
uid=$(/usr/bin/id -u)

# run_helper outside the dry run, with stand-ins for sudo and the password
# dialog. FAKE_SUDO=allow runs the helper, which prints its token and exits
# with FAKE_HELPER_RC, saying so on standard error when that is not 0;
# FAKE_SUDO=refuse is sudo whose rule does not apply.
(
    DRY_RUN=false
    output_file="${work_dir}/output"
    error_file="${work_dir}/error"
    debug_log="${work_dir}/debug"
    helper_path() { printf '%s' "/fake/helper"; }
    helper_is_ready() { return 0; }
    passwordless_is_configured() { return 0; }
    log_debug() { printf '%s\n' "$1" >> "$debug_log"; }
    sudo_without_password() {
        printf 'SUDO %s\n' "$*" >> "$event_log"
        if [[ "$FAKE_SUDO" == "refuse" ]]; then
            printf '%s\n' "sudo: a password is required" >&2
            return 1
        fi
        if [[ "$2" == "check" ]]; then
            return 0
        fi
        printf '%s\n' "session_token=fake"
        if (( FAKE_HELPER_RC != 0 )); then
            printf '%s\n' "awake-helper: failed on purpose." >&2
        fi
        return "$FAKE_HELPER_RC"
    }
    run_as_admin() {
        printf 'PROMPT %s\n' "$*" >> "$event_log"
        ADMIN_LAST_RESULT="ok"
        HELPER_LAST_RC=0
    }
    # Empties both logs, runs run_helper with these arguments, its output in
    # the files above, and sets helper_rc.
    run_logged() {
        : > "$event_log"
        : > "$debug_log"
        helper_rc=0
        run_helper "$@" >"$output_file" 2>"$error_file" || helper_rc=$?
    }
    dialog="Awake needs your password to change the sleep settings."
    # Password-free mode: one sudo run and no check, and the helper's output
    # passes through.
    FAKE_SUDO=allow
    FAKE_HELPER_RC=0
    run_logged gui start "$uid" 60 5 on off
    [[ "$helper_rc" == "0" && "$HELPER_LAST_RC" == "0" && "$ADMIN_LAST_RESULT" == "ok" ]] ||
        fail "a password-free helper run failed (${helper_rc}, ${HELPER_LAST_RC}, ${ADMIN_LAST_RESULT})."
    [[ "$(<"$output_file")" == "session_token=fake" && ! -s "$error_file" ]] ||
        fail "a password-free helper run lost its output: $(<"$output_file") $(<"$error_file")"
    [[ "$(<"$event_log")" == "SUDO /fake/helper start ${uid} 60 5 on off" ]] ||
        fail "password-free mode did not run the helper with one sudo run: $(<"$event_log")"
    # The helper fails, also with 1 as sudo would: after one check, its exit
    # status and message count, and no dialog runs it a second time.
    for FAKE_HELPER_RC in 1 3; do
        run_logged gui start "$uid" 60 5 on off
        [[ "$helper_rc" == "1" && "$HELPER_LAST_RC" == "$FAKE_HELPER_RC" && "$ADMIN_LAST_RESULT" == "failed" ]] ||
            fail "a password-free helper run that exited ${FAKE_HELPER_RC} was not reported as the helper's (${helper_rc}, ${HELPER_LAST_RC}, ${ADMIN_LAST_RESULT})."
        [[ "$(<"$output_file")" == "session_token=fake" && "$(<"$error_file")" == "awake-helper: failed on purpose." ]] ||
            fail "a password-free helper run that exited ${FAKE_HELPER_RC} lost its output: $(<"$output_file") $(<"$error_file")"
        [[ "$(<"$event_log")" == "SUDO /fake/helper start ${uid} 60 5 on off"$'\nSUDO /fake/helper check' ]] ||
            fail "a password-free helper run that exited ${FAKE_HELPER_RC} was not told apart from a refusal by one check: $(<"$event_log")"
        [[ "$(<"$debug_log")" == "run_helper passwordless command=start rc=${FAKE_HELPER_RC}" ]] ||
            fail "a password-free helper run that exited ${FAKE_HELPER_RC} was not logged as expected: $(<"$debug_log")"
    done
    # sudo refuses: its message is dropped, and the dialog asks with the same
    # arguments.
    FAKE_SUDO=refuse
    run_logged gui start "$uid" 60 5 on off
    [[ "$helper_rc" == "0" && "$ADMIN_LAST_RESULT" == "ok" ]] || fail "the dialog after a refusal in password-free mode failed."
    [[ ! -s "$error_file" ]] || fail "sudo's refusal reached the error output: $(<"$error_file")"
    [[ "$(<"$event_log")" == "SUDO /fake/helper start ${uid} 60 5 on off"$'\nSUDO /fake/helper check\n'"PROMPT gui ${dialog} /fake/helper start ${uid} 60 5 on off" ]] ||
        fail "a refusal in password-free mode did not ask with the same arguments: $(<"$event_log")"
    [[ "$(<"$debug_log")" == $'run_helper passwordless command=start rc=1\nrun_helper passwordless_refused rc=1' ]] ||
        fail "a refusal in password-free mode was not logged as expected: $(<"$debug_log")"
    run_logged terminal restore
    [[ "$(<"$event_log")" == $'SUDO /fake/helper restore\nSUDO /fake/helper check\n'"PROMPT terminal ${dialog} /fake/helper restore" ]] ||
        fail "restore did not reach the dialog unchanged: $(<"$event_log")"
    # Without password-free mode the check comes first, as before: a sudo
    # ticket that is still valid runs the helper without a dialog, and a
    # refusal asks.
    passwordless_is_configured() { return 1; }
    FAKE_SUDO=allow
    FAKE_HELPER_RC=0
    run_logged gui extend "$uid" 60
    [[ "$helper_rc" == "0" && "$(<"$event_log")" == $'SUDO /fake/helper check\n'"SUDO /fake/helper extend ${uid} 60" ]] ||
        fail "without password-free mode the check did not come first: $(<"$event_log")"
    FAKE_SUDO=refuse
    run_logged terminal start "$uid" 60 5 on off
    [[ "$helper_rc" == "0" && ! -s "$error_file" &&
        "$(<"$event_log")" == $'SUDO /fake/helper check\n'"PROMPT terminal ${dialog} /fake/helper start ${uid} 60 5 on off" ]] ||
        fail "without password-free mode a refusal did not ask: $(<"$event_log") $(<"$error_file")"
    # The dry run holds back the helper's error output in the same way, and
    # passes both on. The stand-in helper writes its error line first.
    DRY_RUN=true
    printf '%s\n' '#!/bin/bash' 'printf "%s\n" "awake-helper: failed on purpose." >&2' 'printf "%s\n" "ran $*"' 'exit 3' \
        > "${work_dir}/helper"
    /bin/chmod 755 "${work_dir}/helper"
    helper_path() { printf '%s' "${work_dir}/helper"; }
    run_logged gui start "$uid" 60 5 on off
    [[ "$helper_rc" == "1" && "$HELPER_LAST_RC" == "3" && ! -s "$event_log" ]] ||
        fail "a dry-run helper run that exited 3 was not reported as the helper's (${helper_rc}, ${HELPER_LAST_RC}): $(<"$event_log")"
    [[ "$(<"$output_file")" == "ran --dry-run start ${uid} 60 5 on off" && "$(<"$error_file")" == "awake-helper: failed on purpose." ]] ||
        fail "a dry-run helper run lost its output: $(<"$output_file") $(<"$error_file")"
    # Held back until the helper has exited: its error line comes after its
    # output, though it wrote it first.
    run_helper gui start "$uid" 60 5 on off >"$output_file" 2>&1 || true
    [[ "$(<"$output_file")" == "ran --dry-run start ${uid} 60 5 on off"$'\nawake-helper: failed on purpose.' ]] ||
        fail "a dry-run helper run did not hold back its error output: $(<"$output_file")"
)

# After a lid-closed start, the wait ends at once when the session record is
# gone: the helper writes it before it exits, so the session has already
# ended. A stale record, its processes gone, still waits as before: here it
# runs at the fourth check.
(
    helper_session_state() { printf '%s' "none"; }
    started=$SECONDS
    wait_rc=0
    wait_for_helper_session_start || wait_rc=$?
    [[ "$wait_rc" == "2" ]] && (( SECONDS - started <= 1 )) ||
        fail "the wait for a session that had already ended returned ${wait_rc} after $((SECONDS - started)) s."
    helper_session_state() {
        printf '%s\n' "CHECK" >> "$event_log"
        if [[ "$(<"$event_log")" == $'CHECK\nCHECK\nCHECK\nCHECK' ]]; then
            printf '%s' "running"
        else
            printf '%s' "stale"
        fi
    }
    : > "$event_log"
    wait_rc=0
    wait_for_helper_session_start || wait_rc=$?
    [[ "$wait_rc" == "0" && "$(<"$event_log")" == $'CHECK\nCHECK\nCHECK\nCHECK' ]] ||
        fail "the wait for a stale session record returned ${wait_rc} after these checks: $(<"$event_log")"
)

# main then says at once why the session ended, from the helper's record of
# the end if that record is this session's: this account's, and no older
# than the start.
(
    rm -f -- "$STATE_FILE" "$HELPER_SESSION_FILE" "$HELPER_LAST_FILE" "$MOCK_PMSET_FILE" "$MOCK_BATTERY_FILE" "$MOCK_THERMAL_FILE"
    # End to end in the dry run: a session tied to a process that exits as
    # the session starts, once the helper has checked it and written the
    # record. The helper and its timer run as they are; only awake's first
    # look waits, as when the timer's first pass comes before it: run_helper
    # returns once the session has ended.
    eval "real_$(declare -f run_helper)"
    run_helper() {
        local rc=0
        local checks=0

        real_run_helper "$@" || rc=$?
        while [[ -f "$HELPER_SESSION_FILE" ]] && (( checks < 100 )); do
            /bin/sleep 0.1
            checks=$((checks + 1))
        done
        printf '%s %s\n' "$rc" "$SECONDS" > "${work_dir}/helper-returned"
        return "$rc"
    }
    /bin/bash -c 'checks=0; while [[ ! -f "$1" ]] && (( checks < 200 )); do /bin/sleep 0.05; checks=$((checks + 1)); done' \
        watched "$HELPER_SESSION_FILE" &
    watched_pid=$!
    if output=$(main --terminal --backend awake -w "$watched_pid" 2>&1) ||
        [[ "$output" != *"(PID ${watched_pid}) has already exited."* ]]; then
        printf '%s\n' "$output" >&2
        fail "a lid-closed session whose process exited as it started was not reported as such."
    fi
    wait "$watched_pid" || true
    helper_rc=""
    returned_at=""
    read -r helper_rc returned_at < "${work_dir}/helper-returned" || true
    [[ "$helper_rc" == "0" && "$(read_state_value reason "$HELPER_LAST_FILE")" == "process_exited" ]] ||
        fail "the helper did not start the session and end it as process_exited (${helper_rc}, $(read_state_value reason "$HELPER_LAST_FILE"))."
    (( SECONDS - returned_at <= 2 )) ||
        fail "a lid-closed session that had already ended was reported only after $((SECONDS - returned_at)) s."
    # Each reason, with the clock fixed but for a second that passes while
    # the helper runs, as during a password dialog: from this account's
    # record if it is no older than the start, read before the helper runs,
    # otherwise a generic message, as for a timeout. A time that is not a
    # plain number never reaches (( )), where "now" would read as the
    # variable and "${now}+1" as a sum.
    run_helper() { ADMIN_LAST_RESULT="ok"; HELPER_LAST_RC=0; now=$((now + 1)); }
    now=$(/bin/date +%s)
    current_epoch() { printf '%s' "$now"; }
    generic="The awake session ended as soon as it started. Run awake --status-json to see why."
    mkdir -p -- "$HELPER_STATE_DIR"
    for case_line in \
        "overheated|${uid}|${now}|The Mac is overheating, too hot for a lid-closed session. Let it cool down first." \
        "low_battery|${uid}|$((now + 1))|The battery is too low for a lid-closed session. Connect the charger first." \
        "process_exited|${uid}|${now}|(PID $$) has already exited." \
        "timeout|${uid}|${now}|${generic}" \
        "overheated|${uid}|$((now - 100))|${generic}" \
        "overheated|$((uid + 1))|${now}|${generic}" \
        "overheated|${uid}|now|${generic}" \
        "overheated|${uid}|${now}+1|${generic}"; do
        IFS='|' read -r reason last_uid completed_at expected <<< "$case_line"
        printf 'session_token=token-12m-last\nuid=%s\nreason=%s\ncompleted_at=%s\n' "$last_uid" "$reason" "$completed_at" > "$HELPER_LAST_FILE"
        started=$SECONDS
        if output=$(main --terminal --backend awake --duration-seconds 60 -w "$$" 2>&1) ||
            [[ "$output" != *"$expected"* ]] || (( SECONDS - started > 5 )); then
            printf '%s\n' "$output" >&2
            fail "a session that ended as it started was not reported as expected (${case_line}, $((SECONDS - started)) s)."
        fi
    done
    # A wait that runs out of time still reports a failed start.
    wait_for_helper_session_start() { return 1; }
    if output=$(main --terminal --backend awake --duration-seconds 60 2>&1) ||
        [[ "$output" != *"Failed to start the awake session."* ]]; then
        printf '%s\n' "$output" >&2
        fail "a lid-closed start whose session never ran was not reported as failed."
    fi
    rm -f -- "$HELPER_LAST_FILE"
)

get_battery_setting() {
    printf 'PMSET %s\n' "$1" >> "$event_log"
    case "$1" in
        sleep) printf '%s' "$FAKE_SLEEP" ;;
        disablesleep) printf '%s' "$FAKE_DISABLESLEEP" ;;
    esac
}
run_helper() {
    printf 'RUN_HELPER %s\n' "$*" >> "$event_log"
    ADMIN_LAST_RESULT="ok"
    HELPER_LAST_RC=0
}
helper_session_state() { printf '%s' "$FAKE_HELPER_STATE"; }
helper_session_is_foreign() { [[ "$FAKE_HELPER_FOREIGN" == "true" ]]; }
request_helper_session_stop() { printf '%s\n' "HELPER_STOP" >> "$event_log"; }
wait_for_helper_session_start() { return 0; }
state_session_is_active() { [[ -f "$1" && "$FAKE_CAFFEINE_ACTIVE" == "true" ]]; }
request_active_session_stop() { printf '%s\n' "CAFFEINE_STOP" >> "$event_log"; }
change_caffeinate_session_end() {
    printf 'CAFFEINE_EXTEND %s\n' "$1" >> "$event_log"
    RUNNING_DEADLINE=""
}
start_background_caffeinate_session() { printf '%s\n' "CAFFEINE_START" >> "$event_log"; }
wait_for_session_start() { return 0; }
battery_percent_on_battery() { return 1; }
thermal_state() { return 1; }
write_session_file() { :; }
start_gui_completion_notifier() { :; }
notify_gui() { :; }
remove_session_file() { :; }
# Sets up what main finds: no session, normal sleep settings (none left
# behind), and an empty log.
reset_fakes() {
    FAKE_HELPER_STATE=none
    FAKE_HELPER_FOREIGN=false
    FAKE_CAFFEINE_ACTIVE=false
    FAKE_SLEEP=5
    FAKE_DISABLESLEEP=0
    rm -f -- "$STATE_FILE" "$HELPER_SESSION_FILE"
    : > "$event_log"
}
running_lid_closed_session() {
    FAKE_HELPER_STATE=running
    mkdir -p -- "$HELPER_STATE_DIR"
    printf 'session_token=token-12m\nuid=%s\nend_mode=duration\ndeadline_at=%s\n' \
        "$uid" "$(( $(/bin/date +%s) + 600 ))" > "$HELPER_SESSION_FILE"
}
running_lid_open_session() {
    FAKE_CAFFEINE_ACTIVE=true
    ensure_state_dir
    printf 'session_backend=caffeinate\nsession_token=token-12m\nend_mode=duration\ndeadline_at=%s\n' \
        "$(( $(/bin/date +%s) + 600 ))" > "$STATE_FILE"
}
# Runs main with the arguments after $1 and checks what it did, in order,
# against the pattern $1.
expect_events() {
    local expected=$1
    local output=""
    shift

    if ! output=$(main "$@" 2>&1) || [[ "$(<"$event_log")" != $expected ]]; then
        printf '%s\n' "$output" >&2
        fail "main $* did not do what was expected: $(<"$event_log")"
    fi
}
read_once=$'PMSET sleep\nPMSET disablesleep'

# With no session running, each start reads the settings once.
reset_fakes
expect_events "${read_once}"$'\n'"RUN_HELPER terminal start ${uid} 60 ${MIN_BATTERY_PERCENT} on off" --terminal --duration-seconds 60
reset_fakes
expect_events "${read_once}"$'\n'"RUN_HELPER gui start ${uid} 60 ${MIN_BATTERY_PERCENT} on off" --gui --start --duration-seconds 60
reset_fakes
expect_events "${read_once}"$'\n'"CAFFEINE_START" --terminal --backend caffeinate --duration-seconds 60
# A stop or added time while a session runs reads none.
reset_fakes
running_lid_closed_session
expect_events "HELPER_STOP" --gui --stop
reset_fakes
running_lid_closed_session
expect_events "RUN_HELPER terminal extend ${uid} 60" --terminal --duration-seconds 60
reset_fakes
running_lid_open_session
expect_events "CAFFEINE_STOP" --gui --stop
reset_fakes
running_lid_open_session
expect_events "CAFFEINE_EXTEND 60" --terminal --duration-seconds 60
# Nor does a lid-open start while another account's lid-closed session
# runs, which it leaves alone.
reset_fakes
running_lid_closed_session
FAKE_HELPER_FOREIGN=true
expect_events "CAFFEINE_START" --terminal --backend caffeinate --duration-seconds 60
# A session that ends just as time is added: the settings are read once it
# has ended, and a new session starts. A lid-open one restores settings
# left behind first.
extend_running_session() {
    printf '%s\n' "SESSION_ENDED" >> "$event_log"
    FAKE_HELPER_STATE=none
    FAKE_CAFFEINE_ACTIVE=false
    return 3
}
