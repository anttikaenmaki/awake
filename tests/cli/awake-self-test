    printf '%s\n' "Self-test failed: main reported the wrong pmset failure message." >&2
    exit 1
fi
if output=$(main --status-json 2>&1); then
    printf '%s\n' "Self-test failed: main --status-json accepted missing pmset settings." >&2
    exit 1
fi
python3 - "$output" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
if payload.get("active") is not False:
    raise SystemExit("Self-test failed: --status-json did not report inactive status on pmset failure.")
if payload.get("error") != "Could not read the current battery sleep settings from pmset.":
    raise SystemExit("Self-test failed: --status-json did not report the correct pmset failure message.")
