    printf '%s\n' "Self-test failed: helper process matcher ignored the process role." >&2
    exit 1
fi
if helper_process_matches 122 run-timer token-1; then
    printf '%s\n' "Self-test failed: helper process matcher accepted a different session token." >&2
    exit 1
fi
if helper_process_matches 105 run-timer token-1; then
    printf '%s\n' "Self-test failed: helper process matcher accepted an unrelated process." >&2
    exit 1
fi
