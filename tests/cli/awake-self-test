if session_pid_matches 105 /tmp/test-state; then
    printf '%s\n' "Self-test failed: caffeinate session PID matcher accepted an unrelated process." >&2
    exit 1
fi
caffeinate_runner_pid_matches 108 /tmp/test-state
if caffeinate_runner_pid_matches 105 /tmp/test-state; then
    printf '%s\n' "Self-test failed: caffeinate runner PID matcher accepted an unrelated process." >&2
    exit 1
fi
rm -f -- /tmp/test-state

rm -f -- /tmp/alt-state
(
    umask 077
    {
        printf 'session_token=%s\n' "alt-caffeinate-token"
        printf 'script_path=%s\n' "$alt_script_path"
        printf 'pid=%s\n' "112"
        printf 'sleep_pid=%s\n' "113"
        printf 'guard_pid=%s\n' "0"
        printf 'original_sleep=%s\n' "5"
        printf 'original_disablesleep=%s\n' "0"
        printf 'duration_seconds=%s\n' "60"
        printf 'session_mode=%s\n' "terminal"
        printf 'session_backend=%s\n' "caffeinate"
        printf 'sound_notifications=%s\n' "false"
        printf 'started_at=%s\n' "1700000000"
        printf 'deadline_at=%s\n' "1700000060"
    } > /tmp/alt-state
)
session_pid_matches 112 /tmp/alt-state
caffeinate_runner_pid_matches 113 /tmp/alt-state
rm -f -- /tmp/alt-state

if [[ "$(printf 'System-wide power settings:\n SleepDisabled\t\t1\nCurrently in use:\n sleep                0 (sleep prevented by powerd)\n' | parse_pmset_sleep_disabled_setting)" != "1" ]]; then
    printf '%s\n' "Self-test failed: pmset parsing did not read SleepDisabled=1." >&2
    exit 1
fi
