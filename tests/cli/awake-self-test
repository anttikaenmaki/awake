# A process that is not running is refused with only that message.
cleanup_state
if output=$(run_awake --gui -w 999999 2>&1) || [[ "$output" != "No process with ID 999999 is running." ]]; then
    printf '%s\n' "$output" >&2
    fail_test "Self-test failed: --gui -w with a missing process did not give exactly the refusal."
fi

# awake -- COMMAND puts a Mac with a closed lid to sleep when it ends the
# session.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
printf 'state=0\nlid=closed\n' > "$DRY_RUN_MOCK_THERMAL_FILE"
run_awake --terminal -- /usr/bin/true >/dev/null 2>&1 || fail_test "Self-test failed: awake -- /usr/bin/true failed."
# The helper sleeps the Mac just after it records the end.
sleepnow_checks=20
while (( sleepnow_checks > 0 )) && [[ "$(sleepnow_count)" == "0" ]]; do
    /bin/sleep 0.1
    ((sleepnow_checks -= 1))
done
if [[ "$(helper_last_value reason)" != "process_exited" || "$(sleepnow_count)" != "1" ]]; then
    fail_test "Self-test failed: awake -- did not end the lid-closed session with process_exited and sleep ($(helper_last_value reason), $(sleepnow_count))."
fi

# A guardrail end that turned SleepDisabled off is reported.
cleanup_state
write_mock_pmset_state 5 1
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --duration-seconds 60 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the lid-closed session for the SleepDisabled report did not start."
fi
printf 'power_source=battery\npercent=4\n' > "$DRY_RUN_MOCK_BATTERY_FILE"
if ! wait_for_status "Awake is off.*" 40 >/dev/null ||
    [[ "$(run_awake --status)" != *"Awake turned off pmset disablesleep, which was on before the session, so the Mac could sleep."* ]] ||
    [[ "$(json_value "$(run_awake_json)" disablesleep_forced)" != "True" ]]; then
    fail_test "Self-test failed: --status did not report that SleepDisabled was turned off ($(run_awake --status))."
fi
cleanup_state

printf '%s\n' "12h. Verifying the picker's answers, its settings, and the add-time prompt"
if ! run_sourced_picker_checks; then
    fail_test "Self-test failed: the sourced picker checks did not pass."
fi
cleanup_state

printf '%s\n' "12i. Verifying option checks, read-only status, and sessions of other users"
# Values that used to slip through: an empty backend, a --min-battery that
# wraps around into the range, and two different maintenance actions.
for bad_args in "--backend ''" "--min-battery 18446744073709551646" "--passwordless off --install-helper" \
    "--uninstall-helper --passwordless on" "--install-helper --min-battery 20" "--install-helper --backend caffeinate"; do
    if eval "run_awake --terminal $bad_args" >/dev/null 2>&1; then
        fail_test "Self-test failed: awake accepted the invalid options $bad_args."
    fi
done
cleanup_state
# Leading zeros in --duration-seconds are fine.
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --duration-seconds 00000000000060 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: --duration-seconds with leading zeros did not start a session."
fi
# A guardrail or display option alone never stops a running session.
if output=$(run_awake --terminal --min-battery 20 2>&1) ||
    [[ "$output" != *"apply to new sessions only"* ]] || [[ "$(run_awake --status)" != "Awake is on"* ]]; then
    fail_test "Self-test failed: --min-battery during a session did not leave it running ($output)."
fi
if [[ "$(run_awake --terminal --thermal-guard off --duration-seconds 60 2>&1)" != *"keeps its own"*"Added 1 minute."* ]]; then
    fail_test "Self-test failed: adding time with a guardrail option did not say that the session keeps its settings."
fi
run_awake --terminal --stop >/dev/null
if ! wait_for_status "Awake is off." 20 >/dev/null; then
    fail_test "Self-test failed: the session for the option checks did not stop."
fi
# --keep-display has no effect on a lid-closed session, and says so.
if [[ "$(AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --keep-display off --duration-seconds 60 2>&1)" != *"--keep-display applies only to Caffeine sessions"* ]]; then
    fail_test "Self-test failed: --keep-display for a lid-closed session did not say that it is ignored."
fi
run_awake --terminal --stop >/dev/null
wait_for_status "Awake is off." 20 >/dev/null || true
# A command after -- that cannot run is refused before any session starts,
# and awake's own functions never stand in for it.
for missing_command in awake-no-such-command-xyz show_usage; do
    command_rc=0
    run_awake --terminal -- "$missing_command" >/dev/null 2>&1 || command_rc=$?
    if [[ "$command_rc" != "127" || -f "$DRY_RUN_HELPER_SESSION_FILE" ]]; then
        fail_test "Self-test failed: awake -- $missing_command did not fail with 127 before starting a session (got $command_rc)."
    fi
done
command_rc=0
run_awake --terminal -- "$DRY_RUN_STATE_DIR" >/dev/null 2>&1 || command_rc=$?
if [[ "$command_rc" != "126" ]]; then
    fail_test "Self-test failed: awake -- DIRECTORY did not fail with 126 (got $command_rc)."
fi
# --status and --status-json create nothing, and a runtime folder that awake
# cannot trust is reported instead of read.
cleanup_state
# cleanup_state keeps the folder when other files (askpass) are left in it.
rm -rf -- "$DRY_RUN_STATE_DIR"
run_awake --status >/dev/null
run_awake_json >/dev/null
if [[ -e "$DRY_RUN_STATE_DIR" ]]; then
    fail_test "Self-test failed: --status created the runtime folder."
fi
untrusted_dir=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/awake-untrusted.XXXXXX")
ln -s "$untrusted_dir" "$DRY_RUN_STATE_DIR"
status_rc=0
status_json=$(run_awake_json 2>/dev/null) || status_rc=$?
rm -f -- "$DRY_RUN_STATE_DIR"
rmdir -- "$untrusted_dir"
if [[ "$status_rc" == "0" || "$(json_value "$status_json" error)" == "null" ]]; then
    fail_test "Self-test failed: --status-json did not report an untrusted runtime folder as an error ($status_json)."
fi
# Another account's lid-closed session: reported, not changed, and a Caffeine
# session can still start next to it.
cleanup_state
mkdir -p -- "$DRY_RUN_STATE_DIR"
if ! run_helper_dry start 99999 600 10 on >/dev/null; then
    fail_test "Self-test failed: the dry-run helper did not start a session for another user."
fi
if [[ "$(run_awake --status)" != "Another user's lid-closed Awake session is running on this Mac." ||
    "$(json_value "$(run_awake_json)" other_user_session)" != "True" ]]; then
    fail_test "Self-test failed: --status did not report another user's session ($(run_awake --status))."
fi
if output=$(run_awake --terminal --duration-seconds 60 2>&1) || [[ "$output" != *"Only one lid-closed session can run at a time."* ]]; then
    fail_test "Self-test failed: awake tried to change another user's session ($output)."
fi
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 60 >/dev/null
if ! wait_for_status "Awake is on*keep the lid open)." 20 >/dev/null || [[ "$(helper_session_value uid)" != "99999" ]]; then
    fail_test "Self-test failed: a Caffeine session did not start next to another user's session, or ended it."
fi
# The status then describes this account's Caffeine session, which is not
# the other user's.
if [[ "$(json_value "$(run_awake_json)" other_user_session)" != "False" ]]; then
    fail_test "Self-test failed: --status-json called this account's Caffeine session another user's."
fi
run_awake --terminal --stop >/dev/null
if [[ "$(helper_session_value uid)" != "99999" ]]; then
    fail_test "Self-test failed: stopping a Caffeine session ended another user's lid-closed session."
fi
if [[ "$(run_awake --terminal --stop 2>&1)" != *"Stopping it needs an administrator password (not in password-free mode)."* ]] ||
    ! wait_for_helper_session_end 20; then
    fail_test "Self-test failed: an explicit stop did not end another user's session with a warning."
fi
# A Caffeine session whose worker was killed still records how it ended, and
# a stop does not wait for the missing worker.
cleanup_state
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 4 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the Caffeine session for the killed-worker check did not start."
fi
/bin/kill -KILL "$(awk -F= '$1 == "pid" { print $2; exit }' "$DRY_RUN_STATE_FILE")" >/dev/null 2>&1 || true
if ! wait_for_status "Awake is off." 40 >/dev/null ||
    [[ "$(json_value "$(AWAKE_NO_NOTIFICATIONS=true run_awake_json)" last_completion_reason)" != "timeout" ]]; then
    fail_test "Self-test failed: a Caffeine session whose worker was killed did not record its timeout."
fi
cleanup_state
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --indefinite >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the Caffeine session for the killed-worker stop did not start."
fi
/bin/kill -KILL "$(awk -F= '$1 == "pid" { print $2; exit }' "$DRY_RUN_STATE_FILE")" >/dev/null 2>&1 || true
stop_started=$(/bin/date +%s)
run_awake --terminal --stop >/dev/null 2>&1 || true
if (( $(/bin/date +%s) - stop_started > 10 )) || [[ "$(run_awake --status)" != "Awake is off." ]] ||
    [[ "$(json_value "$(run_awake_json)" last_completion_reason)" != "stopped" ]]; then
    fail_test "Self-test failed: stopping a Caffeine session whose worker was killed was slow or failed."
fi
# The same for a session tied to a command: it ends when the command does.
cleanup_state
command_started=$(/bin/date +%s)
AWAKE_NO_NOTIFICATIONS=true AWAKE_DRY_RUN=true /bin/bash "$AWAKE_SCRIPT" --dry-run --terminal --backend caffeinate -- /bin/sleep 4 \
    >/dev/null 2>"${DRY_RUN_STATE_DIR}.command-err" &
bound_awake_pid=$!
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the Caffeine session tied to a command did not start."
fi
/bin/kill -KILL "$(awk -F= '$1 == "pid" { print $2; exit }' "$DRY_RUN_STATE_FILE")" >/dev/null 2>&1 || true
wait "$bound_awake_pid" || true
if (( $(/bin/date +%s) - command_started > 15 )) || [[ "$(run_awake --status)" != "Awake is off." ]] ||
    [[ "$(json_value "$(run_awake_json)" last_completion_reason)" != "process_exited" ]] ||
    [[ "$(cat "${DRY_RUN_STATE_DIR}.command-err")" == *"could not stop"* ]]; then
    fail_test "Self-test failed: a Caffeine session tied to a command whose worker was killed did not end with it ($(cat "${DRY_RUN_STATE_DIR}.command-err"))."
fi
rm -f -- "${DRY_RUN_STATE_DIR}.command-err"
# The Caffeine prompt says when leftover lid-closed settings will need the
# password before it asks how long.
if ! caffeine_banner=$(AWAKE_DRY_RUN=true AWAKE_SCRIPT_PATH="$AWAKE_SCRIPT" /bin/bash -c '
    source "$AWAKE_SCRIPT_PATH"
    read_terminal_response_line() { return 1; }
    SELECTED_SESSION_BACKEND=caffeinate
    LEFTOVER_SETTINGS_PRESENT=true
    prompt_start_terminal 2>&1 || true') ||
    [[ "$caffeine_banner" != *"restored"*"first, which needs your administrator password"* || "$caffeine_banner" == *"No password is needed"* ]]; then
    fail_test "Self-test failed: the Caffeine prompt did not mention the password for leftover settings."
fi
# A timeout that restores SleepDisabled=1 set by the user does not sleep the
# Mac: that setting keeps a closed Mac awake on purpose.
cleanup_state
write_mock_pmset_state 7 1
printf 'state=0\nlid=closed\n' > "$DRY_RUN_MOCK_THERMAL_FILE"
if ! run_helper_dry start "$TEST_UID" 2 10 on >/dev/null || ! wait_for_helper_session_end 20 ||
    [[ "$(sleepnow_count)" != "0" ]] || [[ "$(awk -F= '$1 == "disablesleep" { print $2 }' "$DRY_RUN_MOCK_PMSET_FILE")" != "1" ]]; then
    fail_test "Self-test failed: the helper slept the Mac after restoring the user's SleepDisabled=1."
fi
cleanup_state

# The record of the last Caffeine session stays until a newer session ends:
# a command that finds nothing running, or a start, no longer deletes it, so
# its notifier can still post and --status-json still reports it.
cleanup_state
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 60 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the Caffeine session for the record check did not start."
fi
caffeine_token=$(awk -F= '$1 == "session_token" { print $2; exit }' "$DRY_RUN_STATE_FILE")
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --stop >/dev/null
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --stop >/dev/null
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 60 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null ||
    [[ "$(awk -F= '$1 == "session_token" { print $2; exit }' "$DRY_RUN_STATUS_FILE")" != "$caffeine_token" ]]; then
    fail_test "Self-test failed: a stop with nothing running, or a start, deleted the record of the last Caffeine session."
fi
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --stop >/dev/null
if [[ "$(awk -F= '$1 == "session_token" { print $2; exit }' "$DRY_RUN_STATUS_FILE")" == "$caffeine_token" ]] ||
    [[ "$(json_value "$(run_awake_json)" last_completion_reason)" != "stopped" ]]; then
    fail_test "Self-test failed: the second Caffeine session did not replace the record of the first."
fi
cleanup_state

printf '%s\n' "12j. Verifying the keys at the terminal prompt, and that an open prompt does not block a stop"
# awake's key reader, run in a pseudo-terminal: it prints the answer.
key_reader=(/bin/bash -c 'source "$1"; if read_terminal_response_line answer; then printf "answer=[%s]\n" "$answer"; else printf "cancelled=%s\n" "$?"; fi' _ "$AWAKE_SCRIPT")
# Every printable key is kept (and lowercased), so "1,5h" gets its hint
# instead of turning into "15h"; a NUL byte is ignored.
report=$(run_in_pty $'raw\nsend 31\nsend 2c\nsend 35\nsend 48\nsend 00\nsend 0d' "${key_reader[@]}")
[[ "$report" == *"answer=[1,5h]"* ]] || fail_test "Self-test failed: the prompt did not read 1,5H plus a NUL byte as 1,5h (${report})."
report=$(run_in_pty $'raw\nsend 0d' "${key_reader[@]}")
[[ "$report" == *"answer=[]"* ]] || fail_test "Self-test failed: Enter did not give an empty answer (${report})."
# A character that is not ASCII, such as ä, reads as one ?, so the answer
# gets a hint instead of being read without it.
report=$(run_in_pty $'raw\nsend 31\nsend c3\nsend a4\nsend 35\nsend 0d' "${key_reader[@]}")
[[ "$report" == *"answer=[1?5]"* ]] || fail_test "Self-test failed: 1ä5 was not read as 1?5 (${report})."
# Ctrl+\ cancels; it does not answer with the default.
report=$(run_in_pty $'raw\nsend 33\nsend 1c' "${key_reader[@]}")
[[ "$report" == *"cancelled=1"* ]] || fail_test "Self-test failed: Ctrl+\\ did not cancel the prompt (${report})."
# Ctrl+C ends the line before awake exits.
report=$(run_in_pty $'raw\nsend 32\nsend 03' "${key_reader[@]}")
[[ "$report" == *"exit=130"* && "$report" == *$'output=2\r\n'* ]] ||
    fail_test "Self-test failed: Ctrl+C at the prompt did not end the line and exit with 130 (${report})."
# While the add-time prompt waits for an answer, a stop is not blocked. The
# answer then no longer applies.
cleanup_state
AWAKE_NO_NOTIFICATIONS=true run_awake --terminal --backend caffeinate --duration-seconds 600 >/dev/null
if ! wait_for_status "Awake is on*" 20 >/dev/null; then
    fail_test "Self-test failed: the Caffeine session for the open-prompt check did not start."
fi
report=$(AWAKE_SCRIPT_PATH="$AWAKE_SCRIPT" run_in_pty \
    $'expect ]: \nraw\nshell AWAKE_DRY_RUN=true AWAKE_NO_NOTIFICATIONS=true /bin/bash "$AWAKE_SCRIPT_PATH" --dry-run --terminal --stop\nsend 310d' \
    /usr/bin/env AWAKE_DRY_RUN=true AWAKE_NO_NOTIFICATIONS=true /bin/bash "$AWAKE_SCRIPT" --dry-run --start)
if [[ "$report" != *"shell rc=0 seconds="[0-4]* || "$report" != *"exit=1"* || "$report" != *"no time was added"* ]] ||
    [[ "$(run_awake --status)" != "Awake is off." ]]; then
    fail_test "Self-test failed: an open add-time prompt blocked a stop, or its answer still applied (${report})."
fi
cleanup_state

printf '%s\n' "13. Verifying that --help fits in 80 columns"
if ! help_output=$(run_awake --help); then
    fail_test "Self-test failed: --help did not exit successfully."
fi
if long_lines=$(awk 'length > 80' <<< "$help_output") && [[ -n "$long_lines" ]]; then
    printf '%s\n' "$long_lines" >&2
    fail_test "Self-test failed: --help has lines wider than 80 columns."
fi

printf '%s\n' "All dry-run lifecycle and regression checks passed."
