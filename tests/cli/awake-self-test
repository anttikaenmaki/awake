            read_sleep_settings_for_main
        fi
        brief=$(print_before_status_json false "$case_helper" "$pmset_read_ok" "$pmset_session_active") || true
        active=false
        if state_is_active false "$case_helper" "$pmset_read_ok" "$pmset_session_active"; then
            active=true
        fi
        if ! python3 - "$full" "$brief" "$active" <<'PY'
import json
import sys

full = json.loads(sys.argv[1])
brief = json.loads(sys.argv[2])
if full.get("error"):
    ok = brief == full
else:
    ok = all(brief[key] == full[key] for key in brief) and len(brief) == 10
ok = ok and full["active"] == (sys.argv[3] == "true")
if not ok:
    raise SystemExit(f"{brief} does not match {full} (state_is_active: {sys.argv[3]})")
PY
        then
            printf 'Self-test failed: the report of the state found did not match --status-json for: %s.\n' "$found_case" >&2
            exit 1
        fi
