RUNNING_STALE_PID=""
ALT_AWAKE_TEMP_DIR=""
ALT_AWAKE_SCRIPT=""

run_awake() {
    AWAKE_DRY_RUN=true /bin/bash "$AWAKE_SCRIPT" --dry-run "$@"
}

run_awake_json() {
    run_awake --status-json "$@"
}

ensure_alt_awake_copy() {
    if [[ -n "$ALT_AWAKE_SCRIPT" && -x "$ALT_AWAKE_SCRIPT" ]]; then
        return 0
    fi

    ALT_AWAKE_TEMP_DIR=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/awake-self-test-copy.XXXXXX")
    ALT_AWAKE_SCRIPT="${ALT_AWAKE_TEMP_DIR}/awake-alt"
    cp "$AWAKE_SCRIPT" "$ALT_AWAKE_SCRIPT"
    cp "${REPO_ROOT}/bin/awake-helper" "${ALT_AWAKE_TEMP_DIR}/awake-helper"
    chmod 755 "$ALT_AWAKE_SCRIPT" "${ALT_AWAKE_TEMP_DIR}/awake-helper"
}

run_awake_alt() {
    ensure_alt_awake_copy
    AWAKE_DRY_RUN=true /bin/bash "$ALT_AWAKE_SCRIPT" --dry-run "$@"
}

run_awake_alt_json() {
    run_awake_alt --status-json "$@"
}

fail_test() {
    printf '%s\n' "$1" >&2
    exit 1
}

wait_for_status_with_script() {
    local awake_script=$1
    local expected_pattern=$2
    local max_checks=$3
    local sleep_seconds=${4:-0.25}
    local attempt=0
    local status=""

    while (( attempt < max_checks )); do
        status=$(AWAKE_DRY_RUN=true /bin/bash "$awake_script" --dry-run --status)
        if [[ "$status" == $expected_pattern ]]; then
            printf '%s' "$status"
            return 0
        fi
        /bin/sleep "$sleep_seconds"
        ((attempt += 1))
    done

    printf '%s' "$status"
    return 1
}

wait_for_status() {
    local expected_pattern=$1
    local max_checks=$2
    local sleep_seconds=${3:-0.25}
    local attempt=0
    local status=""

    while (( attempt < max_checks )); do
        status=$(run_awake --status)
        if [[ "$status" == $expected_pattern ]]; then
            printf '%s' "$status"
            return 0
        fi
        /bin/sleep "$sleep_seconds"
        ((attempt += 1))
    done

    printf '%s' "$status"
    return 1
}

json_field_equals() {
    local json_payload=$1
    local field_name=$2
    local expected_value=$3

    python3 - "$json_payload" "$field_name" "$expected_value" <<'PY'
import json
import sys

payload = json.loads(sys.argv[1])
field_name = sys.argv[2]
expected = sys.argv[3]
value = payload.get(field_name)
if expected == "__NULL__":
    ok = value is None
elif expected == "__TRUE__":
    ok = value is True
elif expected == "__FALSE__":
    ok = value is False
else:
    ok = str(value) == expected
if not ok:
    raise SystemExit(f"{field_name}={value!r} did not match {expected!r}")
PY
}

cleanup_state() {
    run_awake --stop >/dev/null 2>&1 || true
    rm -f -- "$DRY_RUN_STATE_FILE" "$DRY_RUN_STATUS_FILE" "$DRY_RUN_SESSION_FILE" "$DRY_RUN_STOP_REQUEST_FILE" "$DRY_RUN_LOG_FILE" "$DRY_RUN_MOCK_PMSET_FILE" "$DRY_RUN_MOCK_BATTERY_FILE"
    rm -rf -- "$DRY_RUN_HELPER_STATE_DIR"
    rmdir -- "$DRY_RUN_STATE_DIR" 2>/dev/null || true
}

cleanup_stale_pid() {
    if [[ -n "$RUNNING_STALE_PID" ]] && /bin/ps -p "$RUNNING_STALE_PID" >/dev/null 2>&1; then
        {
            /bin/kill -TERM "$RUNNING_STALE_PID" >/dev/null 2>&1 || true
            wait "$RUNNING_STALE_PID" || true
        } >/dev/null 2>&1
    fi
    RUNNING_STALE_PID=""
}

cleanup_alt_awake_copy() {
    if [[ -n "$ALT_AWAKE_TEMP_DIR" && -d "$ALT_AWAKE_TEMP_DIR" ]]; then
        rm -rf -- "$ALT_AWAKE_TEMP_DIR"
    fi
    ALT_AWAKE_TEMP_DIR=""
    ALT_AWAKE_SCRIPT=""
}

cleanup() {
    cleanup_stale_pid
    cleanup_state
    cleanup_alt_awake_copy
}

write_mock_pmset_state() {
    local sleep_value=$1
    local disablesleep_value=$2

    mkdir -p -- "$DRY_RUN_STATE_DIR"
    chmod 700 "$DRY_RUN_STATE_DIR"
    (
        umask 077
        {
            printf 'sleep=%s\n' "$sleep_value"
            printf 'disablesleep=%s\n' "$disablesleep_value"
        } > "$DRY_RUN_MOCK_PMSET_FILE"
    )
}

