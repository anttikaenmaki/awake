# The same through the prescan and the environment, the only source of the
# choice for a detached process such as the notifier. Each case runs in a
# fresh shell, as bin/awake sets readonly variables. $2 has the environment,
# the rest are the arguments.
expect_notification_setting() {
    local expected=$1
    local environment=$2
    local actual=""
    shift 2

    # shellcheck disable=SC2086
    actual=$(/usr/bin/env -u AWAKE_NOTIFICATIONS -u AWAKE_NO_NOTIFICATIONS AWAKE_DRY_RUN=true $environment /bin/bash -c \
        'source "$1" "${@:2}"; printf "%s/%s" "$NOTIFICATIONS_SETTING" "$SUPPRESS_NOTIFICATIONS"' _ "$AWAKE_SCRIPT_PATH" "$@") || true
    if [[ "$actual" != "$expected" ]]; then
        printf 'Self-test failed: awake chose %s instead of %s with the environment [%s] and the arguments [%s].\n' \
            "$actual" "$expected" "$environment" "$*" >&2
        exit 1
    fi
}
