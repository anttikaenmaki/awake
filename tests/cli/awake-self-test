    printf '%s\n' "Self-test failed: main lock accepted a notifier helper process." >&2
    exit 1
fi
if main_lock_pid_is_running 105; then
    printf '%s\n' "Self-test failed: main lock accepted an unrelated process." >&2
    exit 1
fi
